<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'pricing' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Plan selection' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Choose your repository coverage</h2>
                        <p class="muted">Compare repository limits, scan cadence, alerts, exports, and findings history.</p>
                    </div>
                    <span class="badge brand">Upgrade anytime</span>
                </section>
                <section class="grid grid-2 pricing-grid-centered" data-public-pricing data-pricing-target="billing">
                    <div class="empty-state">Loading current plans...</div>
                </section>

                <section class="card" style="margin-top:18px">
                    <div class="card-header">
                        <h2 class="card-title">What Happens Next</h2>
                        <span class="badge brand">Onboarding</span>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Step</th><th>Purpose</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr><td>Hosted checkout</td><td>Activate the plan through the selected payment processor once connected.</td><td><span class="badge warning">Pending checkout</span></td></tr>
                                <tr><td>GitHub App install</td><td>Select the repositories SecureRepos should scan.</td><td><span class="badge brand">Next</span></td></tr>
                                <tr><td>First scan</td><td>Choose repositories and start initial scan.</td><td><span class="badge success">Ready</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
