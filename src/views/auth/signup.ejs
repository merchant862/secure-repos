<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div>
                <h1 style="font-size:42px;line-height:1.08;margin:0 0 16px">Start checking your GitHub repositories in minutes.</h1>
                <p style="color:#d0d5dd;max-width:560px">Choose a plan, install the GitHub App, and review branch-level findings without setting up a heavy security platform.</p>
            </div>
            <p style="color:#98a2b3;margin:0">Clear repository limits. Clear scan limits. No unlimited plan claims.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <a class="muted small" href="/sign-in">Already have an account?</a>
                <h1 style="margin:22px 0 8px">Create account</h1>
                <p class="muted" style="margin:0 0 26px">Create your account first. Plan activation and GitHub setup come next.</p>
                <form method="post" action="/api/auth/signup">
                    <% if (typeof planSlug !== 'undefined' && planSlug) { %>
                        <input type="hidden" name="planSlug" value="<%= planSlug %>">
                    <% } %>
                    <% if (typeof checkoutToken !== 'undefined' && checkoutToken) { %>
                        <input type="hidden" name="checkoutToken" value="<%= checkoutToken %>">
                    <% } %>
                    <div class="form-field">
                        <label>Name</label>
                        <input class="input" type="text" name="name" autocomplete="name" required>
                    </div>
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required>
                    </div>
                    <div class="form-field">
                        <label>Password</label>
                        <div class="password-field"><input class="input" type="password" name="password" autocomplete="new-password" minlength="12" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                    </div>
                    <button class="button primary" type="submit" style="width:100%">Create account</button>
                    <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                </form>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
