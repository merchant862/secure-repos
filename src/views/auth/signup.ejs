<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div class="auth-copy-main">
                <span class="auth-eyebrow">Create workspace</span>
                <h1>Start checking selected GitHub repositories in minutes.</h1>
                <p>Verify your email, activate checkout, connect GitHub, then run the first repository scan from onboarding.</p>
                <ul class="auth-proof-list">
                    <li>One GitHub account is linked to the workspace to reduce abuse.</li>
                    <li>Preview access is intentionally limited before full subscription activation.</li>
                    <li>Plan limits are clear before you connect repositories.</li>
                </ul>
            </div>
            <p class="auth-copy-foot">No unlimited claims. No shared account model. No card details handled by SecureRepos.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <div class="auth-card-top"><a class="muted small" href="/sign-in">Already have an account?</a><span class="badge success">Email required</span></div>
                <h1>Create account</h1>
                <p class="auth-card-subcopy">Create your account, verify your email, then complete plan activation and GitHub setup.</p>
                <a class="button primary" href="/api/auth/github" style="width:100%;margin-bottom:14px">Continue with GitHub</a>
                <div class="auth-divider"><span>or email</span></div>
                <form method="post" action="/api/auth/signup">
                    <% if (typeof planSlug !== 'undefined' && planSlug) { %>
                        <input type="hidden" name="planSlug" value="<%= planSlug %>">
                    <% } %>
                    <% if (typeof checkoutToken !== 'undefined' && checkoutToken) { %>
                        <input type="hidden" name="checkoutToken" value="<%= checkoutToken %>">
                    <% } %>
                    <div class="form-field">
                        <label>Name</label>
                        <input class="input" type="text" name="name" autocomplete="name" required>
                    </div>
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required>
                    </div>
                    <div class="form-field">
                        <label>Password</label>
                        <div class="password-field"><input class="input" type="password" name="password" autocomplete="new-password" minlength="12" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                    </div>
                    <button class="button primary" type="submit" style="width:100%">Create account</button>
                    <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                </form>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
