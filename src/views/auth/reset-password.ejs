<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div>
                <h1 style="font-size:42px;line-height:1.08;margin:0 0 16px">Set a new password.</h1>
                <p style="color:#d0d5dd;max-width:560px">Choose a strong password. Existing sessions are revoked after reset.</p>
            </div>
            <p style="color:#98a2b3;margin:0">Use 12 to 128 characters.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <a class="muted small" href="/sign-in">Back to sign in</a>
                <h1 style="margin:22px 0 8px">New password</h1>
                <p class="muted" style="margin:0 0 26px">Enter a new password for your SecureRepos account.</p>
                <% if (!token) { %>
                    <div class="empty-state" style="margin:0">This reset link is missing a token. Request a new password reset email.</div>
                    <a class="button primary" href="/forgot-password" style="width:100%;margin-top:16px">Request reset link</a>
                <% } else { %>
                    <form method="post" action="/api/auth/password-reset/confirm" data-auth-flow="password-reset-confirm">
                        <input type="hidden" name="token" value="<%= token %>">
                        <div class="form-field">
                            <label>New password</label>
                            <div class="password-field"><input class="input" type="password" name="password" autocomplete="new-password" minlength="12" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                        </div>
                        <button class="button primary" type="submit" style="width:100%">Reset password</button>
                        <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                    </form>
                <% } %>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
