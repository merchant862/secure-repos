<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div class="auth-copy-main">
                <span class="auth-eyebrow">Account verification</span>
                <h1>Check your inbox before continuing.</h1>
                <p>SecureRepos only activates accounts with a verified email address. The link is single-use and expires after 24 hours.</p>
                <ul class="auth-proof-list">
                    <li>Email verification comes before checkout and GitHub access.</li>
                    <li>Verification links are single-use.</li>
                    <li>After verification, sign in and continue onboarding.</li>
                </ul>
            </div>
            <p class="auth-copy-foot">Check spam or promotions if the message does not arrive within a minute.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <div class="auth-card-top"><a class="muted small" href="/sign-in">Back to sign in</a><span class="badge success">Account created</span></div>
                <h1>Verify your email</h1>
                <p class="auth-card-subcopy">Open the verification link we sent, then return to sign in.</p>
                <form method="post" action="/api/auth/email-verification/resend" data-auth-flow="verification-resend">
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required data-verification-email>
                    </div>
                    <button class="button" type="submit" style="width:100%">Resend verification link</button>
                    <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                </form>
                <a class="button primary" href="/sign-in" style="width:100%;margin-top:14px">Go to sign in</a>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
