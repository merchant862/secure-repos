<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div class="auth-copy-main">
                <span class="auth-eyebrow">Workspace sign in</span>
                <h1>Keep repository risk visible before it ships.</h1>
                <p>Review the affected file, branch, severity, evidence, and remediation status from one focused security workspace.</p>
                <ul class="auth-proof-list">
                    <li>GitHub App access stays limited to selected repositories.</li>
                    <li>Critical and high-risk alerts are sent without exposing billing or account controls to API tokens.</li>
                    <li>Every login is protected by an email OTP step.</li>
                </ul>
            </div>
            <p class="auth-copy-foot">Built for independent developers, agencies, and small teams that need practical repository security.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <div class="auth-card-top"><a class="muted small" href="/">Back to home</a><span class="badge brand">OTP protected</span></div>
                <h1>Sign in</h1>
                <p class="auth-card-subcopy">Use the email and password attached to your account.</p>
                <p class="muted small" data-auth-page-status style="margin:0 0 14px"></p>
                <a class="button primary" href="/api/auth/github" style="width:100%;margin-bottom:14px">Continue with GitHub</a>
                <div class="auth-divider"><span>or email</span></div>
                <form method="post" action="/api/auth/login">
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required>
                    </div>
                    <div class="form-field">
                        <label>Password</label>
                        <div class="password-field"><input class="input" type="password" name="password" autocomplete="current-password" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                    </div>
                    <button class="button primary" type="submit" style="width:100%">Sign in</button>
                    <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                </form>
                <p class="muted small" style="margin-top:18px"><a href="/forgot-password" style="color:var(--brand-strong);font-weight:700">Forgot password?</a></p>
                <p class="muted small" style="margin-top:10px">New to SecureRepos? <a href="/sign-up" style="color:var(--brand-strong);font-weight:700">Create an account</a></p>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
