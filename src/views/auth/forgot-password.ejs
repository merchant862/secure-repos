<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div>
                <h1 style="font-size:42px;line-height:1.08;margin:0 0 16px">Reset access without weakening account security.</h1>
                <p style="color:#d0d5dd;max-width:560px">SecureRepos sends a short-lived reset link to the email on your account.</p>
            </div>
            <p style="color:#98a2b3;margin:0">Reset links expire after 30 minutes.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <a class="muted small" href="/sign-in">Back to sign in</a>
                <h1 style="margin:22px 0 8px">Reset password</h1>
                <p class="muted" style="margin:0 0 26px">Enter your account email and we will send a secure reset link if it exists.</p>
                <form method="post" action="/api/auth/password-reset/request" data-auth-flow="password-reset-request">
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required>
                    </div>
                    <button class="button primary" type="submit" style="width:100%">Send reset link</button>
                    <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                </form>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
