<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div class="auth-copy-main">
                <span class="auth-eyebrow">Password recovery</span>
                <h1>Reset access without weakening account security.</h1>
                <p>SecureRepos sends a short-lived reset link to the registered email address only.</p>
                <ul class="auth-proof-list">
                    <li>Reset links expire after 30 minutes.</li>
                    <li>Existing sessions are revoked after a successful password reset.</li>
                    <li>The response stays generic so account existence is not exposed.</li>
                </ul>
            </div>
            <p class="auth-copy-foot">Never share reset links, OTP codes, API keys, or GitHub tokens with support.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <div class="auth-card-top"><a class="muted small" href="/sign-in">Back to sign in</a><span class="badge brand">30 min link</span></div>
                <h1>Reset password</h1>
                <p class="auth-card-subcopy">Enter your account email and we will send a secure reset link if it exists.</p>
                <form method="post" action="/api/auth/password-reset/request" data-auth-flow="password-reset-request">
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required>
                    </div>
                    <button class="button primary" type="submit" style="width:100%">Send reset link</button>
                    <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                </form>
            </div>
        </section>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
