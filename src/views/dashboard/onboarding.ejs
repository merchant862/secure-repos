<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'dashboard' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Setup flow' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Launch your workspace</h2>
                        <p class="muted" data-onboarding-copy>Confirm your payment method, connect one GitHub repository, and run the limited Security Preview.</p>
                    </div>
                    <span class="badge brand" data-onboarding-badge>Setup</span>
                </section>
                <section class="onboarding-steps" data-onboarding-steps>
                    <article class="card card-body step-card active" data-onboarding-step="account"><span class="step-number">1</span><strong>Workspace created</strong><p class="muted small" data-step-copy="account">Your SecureRepos account and workspace are ready.</p></article>
                    <article class="card card-body step-card" data-onboarding-step="billing"><span class="step-number">2</span><strong>Payment method</strong><p class="muted small" data-step-copy="billing">Confirm your card in Paddle before connecting GitHub.</p><a class="button primary" href="/checkout" data-step-action="billing">Continue to checkout</a></article>
                    <article class="card card-body step-card" data-onboarding-step="github"><span class="step-number">3</span><strong>Connect GitHub</strong><p class="muted small" data-step-copy="github">This GitHub account is permanently bound after connection.</p><button class="button primary" type="button" data-provider-connect="github" data-step-action="github">Install GitHub App</button></article>
                    <article class="card card-body step-card" data-onboarding-step="repositories"><span class="step-number">4</span><strong>Repository access</strong><p class="muted small" data-step-copy="repositories">Selected repositories appear after GitHub sync.</p><a class="button" href="/repositories" data-step-action="repositories">View repositories</a></article>
                    <article class="card card-body step-card" data-onboarding-step="scan"><span class="step-number">5</span><strong>Security Preview</strong><p class="muted small" data-step-copy="scan">Run one limited preview scan once your repository is ready.</p><a class="button" href="/repositories" data-step-action="scan">Start preview</a></article>
                </section>
                <section class="onboarding-wizard" data-onboarding-wizard>
                    <div class="card onboarding-wizard-panel">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title" data-onboarding-wizard-title>Finish setup</h2>
                                <p class="muted small" data-onboarding-wizard-copy>SecureRepos will unlock the next step after checkout is confirmed.</p>
                            </div>
                            <span class="badge brand" data-onboarding-wizard-badge>Waiting</span>
                        </div>
                        <div class="card-body">
                            <div class="onboarding-action-card" data-onboarding-action-card>
                                <span class="badge brand" data-onboarding-action-badge>Step 1</span>
                                <h3 data-onboarding-action-title>Activate your plan</h3>
                                <p class="muted" data-onboarding-action-copy>Complete Paddle checkout for the SecureRepos package. Repository access unlocks after confirmation.</p>
                                <div class="onboarding-action-row">
                                    <a class="button primary" href="/checkout" data-onboarding-primary-action>Continue to checkout</a>
                                    <a class="button" href="/billing" data-onboarding-secondary-action hidden>Open billing</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
