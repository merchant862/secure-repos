<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'dashboard' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Setup flow' }) %>
            <main class="content">
                <section class="page-toolbar"><div><h2>Launch your workspace</h2><p class="muted">Choose a plan, activate access through checkout, install the GitHub App, and run the first scan.</p></div><span class="badge brand">4 steps</span></section>
                <section class="onboarding-steps">
                    <article class="card card-body step-card active"><span class="step-number">1</span><strong>Select plan</strong><p class="muted small">Choose the package that matches repository and team limits.</p><a class="button" href="/pricing">Choose plan</a></article>
                    <article class="card card-body step-card"><span class="step-number">2</span><strong>Hosted checkout</strong><p class="muted small">Complete payment through the final card processor once configured.</p><a class="button" href="/billing">Open billing</a></article>
                    <article class="card card-body step-card"><span class="step-number">3</span><strong>Install GitHub App</strong><p class="muted small">Select the GitHub repositories SecureRepos should scan.</p><a class="button" href="/repositories">Connect</a></article>
                    <article class="card card-body step-card"><span class="step-number">4</span><strong>First scan</strong><p class="muted small">Select a repository and run the first scan.</p><a class="button primary" href="/repositories">Start scan</a></article>
                </section>
                <section class="card" style="margin-top:18px"><div class="card-header"><h2 class="card-title">Recommended flow</h2><span class="badge success">Email first</span></div><div class="card-body"><p class="muted">Email/password signup creates the workspace first. After checkout, GitHub App installation is tied to the workspace cleanly.</p></div></section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
