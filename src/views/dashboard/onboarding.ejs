<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'dashboard' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Setup flow' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Launch your workspace</h2>
                        <p class="muted" data-onboarding-copy>Complete checkout first, then connect GitHub and run the first repository scan.</p>
                    </div>
                    <span class="badge brand" data-onboarding-badge>Setup</span>
                </section>
                <section class="onboarding-steps" data-onboarding-steps>
                    <article class="card card-body step-card active" data-onboarding-step="account"><span class="step-number">1</span><strong>Workspace created</strong><p class="muted small" data-step-copy="account">Your SecureRepos account and workspace are ready.</p><a class="button" href="/dashboard">Open dashboard</a></article>
                    <article class="card card-body step-card" data-onboarding-step="billing"><span class="step-number">2</span><strong>Payment confirmed</strong><p class="muted small" data-step-copy="billing">Complete Paddle checkout before scanning repositories.</p><a class="button primary" href="/billing" data-step-action="billing">Open billing</a></article>
                    <article class="card card-body step-card" data-onboarding-step="github"><span class="step-number">3</span><strong>Connect GitHub</strong><p class="muted small" data-step-copy="github">Install the GitHub App with selected repository access.</p><button class="button primary" type="button" data-provider-connect="github" data-step-action="github">Install GitHub App</button></article>
                    <article class="card card-body step-card" data-onboarding-step="repositories"><span class="step-number">4</span><strong>Repository access</strong><p class="muted small" data-step-copy="repositories">Selected repositories appear after GitHub sync.</p><a class="button" href="/repositories" data-step-action="repositories">View repositories</a></article>
                    <article class="card card-body step-card" data-onboarding-step="scan"><span class="step-number">5</span><strong>First scan</strong><p class="muted small" data-step-copy="scan">Start a scan once your repository list is ready.</p><a class="button" href="/repositories" data-step-action="scan">Start scan</a></article>
                </section>
                <section class="onboarding-wizard" data-onboarding-wizard>
                    <div class="card onboarding-wizard-panel">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title" data-onboarding-wizard-title>Finish setup</h2>
                                <p class="muted small" data-onboarding-wizard-copy>SecureRepos will unlock the next step after checkout is confirmed.</p>
                            </div>
                            <span class="badge brand" data-onboarding-wizard-badge>Waiting</span>
                        </div>
                        <div class="card-body">
                            <div class="onboarding-action-card" data-onboarding-action-card>
                                <span class="badge brand" data-onboarding-action-badge>Step 1</span>
                                <h3 data-onboarding-action-title>Activate your plan</h3>
                                <p class="muted" data-onboarding-action-copy>Choose a package and complete Paddle checkout. Repository scanning starts only after payment is confirmed.</p>
                                <div class="onboarding-action-row">
                                    <a class="button primary" href="/billing" data-onboarding-primary-action>Open billing</a>
                                    <a class="button" href="/billing" data-onboarding-secondary-action>Open billing</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <aside class="card onboarding-wizard-panel">
                        <div class="card-header"><h2 class="card-title">GitHub wizard</h2><span class="badge brand" data-onboarding-flow-badge>Guided</span></div>
                        <div class="card-body">
                            <div class="timeline-list onboarding-guide-list">
                                <article data-onboarding-guide="payment"><span class="badge brand">1</span><div><strong>Payment</strong><p class="muted small">Paddle confirms the subscription before repository access opens.</p></div></article>
                                <article data-onboarding-guide="install"><span class="badge brand">2</span><div><strong>Install app</strong><p class="muted small">Select only the repositories included in your plan.</p></div></article>
                                <article data-onboarding-guide="sync"><span class="badge brand">3</span><div><strong>Sync repositories</strong><p class="muted small">SecureRepos imports selected repository metadata and branch access.</p></div></article>
                                <article data-onboarding-guide="scan"><span class="badge brand">4</span><div><strong>Run scan</strong><p class="muted small">Start the first scan and review findings from the dashboard.</p></div></article>
                            </div>
                        </div>
                    </aside>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
