<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'dashboard' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Setup flow' }) %>
            <main class="content">
                <section class="page-toolbar"><div><h2>Launch your workspace</h2><p class="muted">Your workspace is ready. Install the GitHub App, select repositories, and run the first scan.</p></div><span class="badge brand">GitHub setup</span></section>
                <section class="onboarding-steps">
                    <article class="card card-body step-card active"><span class="step-number">1</span><strong>Workspace created</strong><p class="muted small">Your Secure Repos account and workspace are active.</p><a class="button" href="/dashboard">Open dashboard</a></article>
                    <article class="card card-body step-card"><span class="step-number">2</span><strong>Install GitHub App</strong><p class="muted small">Connect GitHub with selected repository access.</p><button class="button primary" type="button" data-provider-connect="github">Install GitHub App</button></article>
                    <article class="card card-body step-card"><span class="step-number">3</span><strong>Review repositories</strong><p class="muted small">Connected repositories appear in your inventory after GitHub sync.</p><a class="button" href="/repositories">View repositories</a></article>
                    <article class="card card-body step-card"><span class="step-number">4</span><strong>Run first scan</strong><p class="muted small">Start a scan from the repository table once a repo is connected.</p><a class="button" href="/repositories">Start scan</a></article>
                </section>
                <section class="card" style="margin-top:18px"><div class="card-header"><h2 class="card-title">Recommended flow</h2><span class="badge success">GitHub first</span></div><div class="card-body"><p class="muted">Install the GitHub App from this workspace so the installation callback can attach selected repositories to the correct tenant.</p></div></section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
