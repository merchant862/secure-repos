<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'billing' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Plan activation' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Activate workspace access</h2>
                        <p class="muted">Payment provider is intentionally on hold. The billing page is ready for the final hosted checkout integration.</p>
                    </div>
                    <span class="badge warning">Checkout pending</span>
                </section>
                <section class="grid grid-2">
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Selected Plan</h2><span class="badge brand">Workspace</span></div>
                        <div class="card-body"><div class="metric-value">--</div><p class="muted">Plan details load from your workspace subscription record.</p><a class="button" href="/pricing">Change plan</a></div>
                    </article>
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Checkout Status</h2><span class="badge brand">Provider agnostic</span></div>
                        <div class="card-body">
                            <p class="muted">Hosted payment collection will happen inside the final card or merchant provider, not inside this app.</p>
                            <div class="timeline-list compact">
                                <article><span class="badge success">Ready</span><div><strong>Plan intent</strong><p class="muted small">The selected plan can be passed to any checkout provider.</p></div></article>
                                <article><span class="badge warning">Pending</span><div><strong>Payment adapter</strong><p class="muted small">Final merchant integration will activate the subscription.</p></div></article>
                            </div>
                            <button class="button primary" type="button" disabled>Checkout pending</button>
                        </div>
                    </article>
                </section>
                <section class="card" style="margin-top:18px">
                    <div class="card-header"><h2 class="card-title">Checkout Path</h2></div>
                    <div class="timeline-list">
                        <article><span class="badge success">Done</span><div><strong>Workspace created</strong><p class="muted small">Account is ready.</p></div></article>
                        <article><span class="badge brand">Ready</span><div><strong>Plan selection</strong><p class="muted small">Choose a plan before hosted checkout.</p></div></article>
                        <article><span class="badge warning">Pending</span><div><strong>Hosted checkout</strong><p class="muted small">Final provider will activate the workspace after successful payment.</p></div></article>
                        <article><span class="badge brand">Next</span><div><strong>GitHub App install</strong><p class="muted small">Selected repository access follows payment.</p></div></article>
                    </div>
                </section>
                <section class="card" style="margin-top:18px">
                    <div class="card-header"><h2 class="card-title">Subscription Controls</h2><span class="badge warning">Owner only</span></div>
                    <form class="card-body" data-api-form="cancel-subscription">
                        <p class="muted">This account is for one independent developer. You can cancel future renewals from this page after a payment provider is connected.</p>
                        <button class="button danger" type="submit">Cancel subscription</button>
                        <span class="small muted" data-form-status></span>
                    </form>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
