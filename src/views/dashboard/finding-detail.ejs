<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'findings' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: `Finding #${findingId}` }) %>
            <main class="content">
                <section class="page-toolbar"><div><h2>Finding detail</h2><p class="muted">Finding data loads from your authenticated workspace.</p></div><span class="badge brand">GitHub</span></section>
                <section class="grid grid-2">
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Evidence</h2></div>
                        <pre class="code-preview">No evidence loaded yet.</pre>
                    </article>
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Workflow</h2><span class="badge brand">Owner action</span></div>
                        <div class="card-body">
                            <div class="form-field"><label>Status</label><select class="input"><option>Open</option><option>Resolved</option><option>Ignored</option></select></div>
                            <div class="toolbar-actions" style="justify-content:flex-start"><button class="button">Snooze</button><button class="button primary">Resolve</button></div>
                        </div>
                    </article>
                </section>
                <section class="card" style="margin-top:18px"><div class="card-header"><h2 class="card-title">Recommendation</h2></div><div class="card-body"><p class="muted">Run a scan and open a real finding to review scanner evidence and remediation guidance.</p></div></section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
