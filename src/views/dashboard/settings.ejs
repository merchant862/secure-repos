<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'settings' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Workspace controls' }) %>
            <main class="content">
                <section class="card">
                    <div class="card-header"><h2 class="card-title">Change Password</h2><span class="badge brand">Account security</span></div>
                    <form class="card-body" data-api-form="password-change">
                        <div class="form-field">
                            <label>Current password</label>
                            <div class="password-field"><input class="input" type="password" name="currentPassword" autocomplete="current-password" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                        </div>
                        <div class="grid grid-2">
                            <div class="form-field">
                                <label>New password</label>
                                <div class="password-field"><input class="input" type="password" name="newPassword" autocomplete="new-password" minlength="12" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                            </div>
                            <div class="form-field">
                                <label>Confirm new password</label>
                                <div class="password-field"><input class="input" type="password" name="confirmPassword" autocomplete="new-password" minlength="12" maxlength="128" required><button class="button compact" type="button" data-password-toggle>Show</button></div>
                            </div>
                        </div>
                        <button class="button primary" type="submit">Update password</button>
                        <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                    </form>
                </section>
                <section class="card" style="margin-top:18px" data-cli-token-section>
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">CLI Access</h2>
                            <p class="muted small">Create short-lived credentials for the SecureRepos CLI. Tokens only access approved repositories and cannot manage your account or billing.</p>
                        </div>
                        <span class="badge brand">30 days maximum</span>
                    </div>
                    <form class="card-body cli-token-form" data-cli-token-form>
                        <div class="form-field">
                            <label for="cli-token-name">Token name</label>
                            <input class="input" id="cli-token-name" name="name" maxlength="100" placeholder="Development laptop" required>
                        </div>
                        <div class="form-field">
                            <label for="cli-token-expiry">Expires after</label>
                            <select class="input" id="cli-token-expiry" name="expiresInDays" required>
                                <option value="1">1 day</option>
                                <option value="7">7 days</option>
                                <option value="14">14 days</option>
                                <option value="30" selected>30 days</option>
                            </select>
                        </div>
                        <button class="button primary" type="submit">Generate token</button>
                        <p class="muted small" data-cli-token-status></p>
                    </form>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Name</th><th>Token</th><th>Status</th><th>Last used</th><th></th></tr></thead>
                            <tbody data-api-table="cli-tokens"><tr><td colspan="5">Loading CLI tokens...</td></tr></tbody>
                        </table>
                    </div>
                    <div class="card-body" style="border-top:1px solid var(--border)">
                        <div class="grid grid-2">
                            <article>
                                <strong>CLI scan</strong>
                                <pre class="code-preview" style="margin-top:10px">npm install -g @securerepos/cli
securerepos scan --api-key srp_cli_xxxxx</pre>
                            </article>
                            <article>
                                <strong>MCP for coding agents</strong>
                                <pre class="code-preview" style="margin-top:10px">{
  "mcpServers": {
    "securerepos": {
      "command": "npx",
      "args": ["@securerepos/mcp"],
      "env": { "SECUREREPOS_API_KEY": "srp_cli_xxxxx" }
    }
  }
}</pre>
                            </article>
                        </div>
                    </div>
                </section>
                <section class="card" style="margin-top:18px">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Alert Channels</h2>
                            <p class="muted small">Critical and high-risk alerts can also go to Slack, Discord, Microsoft Teams, Telegram, or GitHub Issues. Secrets are encrypted and never shown again.</p>
                        </div>
                        <span class="badge warning">High risk only</span>
                    </div>
                    <form class="card-body" data-alert-channel-form>
                        <div class="grid grid-3">
                            <div class="form-field">
                                <label>Channel</label>
                                <select class="input" name="provider" required>
                                    <option value="slack">Slack</option>
                                    <option value="discord">Discord</option>
                                    <option value="teams">Microsoft Teams</option>
                                    <option value="telegram">Telegram</option>
                                    <option value="github_issues">GitHub Issues</option>
                                </select>
                            </div>
                            <div class="form-field">
                                <label>Name</label>
                                <input class="input" name="name" maxlength="100" placeholder="Security alerts" required>
                            </div>
                            <div class="form-field" data-alert-webhook-field>
                                <label>Webhook URL</label>
                                <input class="input" name="webhookUrl" type="url" inputmode="url" placeholder="https://..." required>
                            </div>
                            <div class="form-field" data-alert-telegram-field hidden>
                                <label>Bot token</label>
                                <input class="input" name="botToken" placeholder="123456:ABC..." autocomplete="off">
                            </div>
                            <div class="form-field" data-alert-telegram-field hidden>
                                <label>Chat ID</label>
                                <input class="input" name="chatId" placeholder="-1001234567890">
                            </div>
                            <div class="form-field" data-alert-github-field hidden>
                                <label>Issue repository</label>
                                <select class="input" name="repositoryId" data-alert-github-repositories>
                                    <option value="">Loading repositories...</option>
                                </select>
                            </div>
                        </div>
                        <button class="button primary" type="submit">Connect alert channel</button>
                        <p class="muted small" data-alert-channel-status style="margin:12px 0 0"></p>
                    </form>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Channel</th><th>Name</th><th>Status</th><th>Last delivered</th><th></th></tr></thead>
                            <tbody data-api-table="alert-channels"><tr><td colspan="5">Loading alert channels...</td></tr></tbody>
                        </table>
                    </div>
                </section>
                <section class="card" style="margin-top:18px">
                    <div class="card-header"><h2 class="card-title">Audit Log</h2></div>
                    <div class="table-wrap">
                        <table><thead><tr><th>Action</th><th>Entity</th><th>Time</th></tr></thead><tbody data-api-table="audit-logs"><tr><td colspan="3">Loading audit events...</td></tr></tbody></table>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
