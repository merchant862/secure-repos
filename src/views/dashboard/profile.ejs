<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'profile' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Account' }) %>
            <main class="content">
                <section class="grid grid-2">
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Profile</h2><span class="badge brand">/api/user/me</span></div>
                        <div class="card-body" data-profile-card><div class="profile-row"><span class="profile-avatar">U</span><div><strong>Signed-in user</strong><p class="muted small">Profile details load after login.</p></div></div><button class="button" type="button" data-logout style="margin-top:18px">Log out</button></div>
                    </article>
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Session and devices</h2><span class="badge success">Token based</span></div>
                        <div class="card-body"><p class="muted">Current UI uses bearer token stored in browser localStorage. Device/session management can be backed by the existing session table if we expose session-list endpoints.</p><div class="profile-row"><span class="provider-icon">1</span><div><strong>Current browser</strong><p class="muted small">Active session</p></div></div></div>
                    </article>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
