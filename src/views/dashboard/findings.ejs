<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'findings' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Triage queue' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Finding triage</h2>
                        <p class="muted">Resolve, ignore, or snooze findings from scanner results.</p>
                    </div>
                    <div class="toolbar-actions">
                        <select class="input compact" data-findings-status-filter>
                            <option value="open">Open</option>
                            <option value="snoozed">Snoozed</option>
                            <option value="resolved">Resolved</option>
                            <option value="ignored">Ignored</option>
                            <option value="all">All</option>
                        </select>
                    </div>
                </section>

                <section class="grid grid-4">
                    <article class="card card-body"><span class="badge danger">Critical</span><div class="metric-value" data-finding-metric="critical">--</div><div class="metric-label">must fix</div></article>
                    <article class="card card-body"><span class="badge warning">High</span><div class="metric-value" data-finding-metric="high">--</div><div class="metric-label">needs owner</div></article>
                    <article class="card card-body"><span class="badge brand">Snoozed</span><div class="metric-value" data-finding-metric="snoozed">--</div><div class="metric-label">time boxed</div></article>
                    <article class="card card-body"><span class="badge success">Resolved</span><div class="metric-value" data-finding-metric="resolved">--</div><div class="metric-label">this month</div></article>
                </section>

                <section class="card" style="margin-top:18px">
                    <div class="card-header">
                        <h2 class="card-title">Open Findings</h2>
                        <span class="badge brand">/api/user/findings</span>
                    </div>
                    <div class="finding-list" data-api-list="findings">
                        <div class="empty-state">Loading findings...</div>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
