<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'team' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'People and access' }) %>
            <main class="content">
                <section class="grid grid-2">
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Invite Member</h2><span class="badge brand">Owner/Admin</span></div>
                        <form class="card-body" data-api-form="invite-member">
                            <div class="form-field"><label>Email</label><input class="input" name="email" type="email" placeholder="developer@company.com" required></div>
                            <div class="form-field"><label>Role</label><select class="input" name="role"><option value="member">Member</option><option value="admin">Admin</option></select></div>
                            <button class="button primary" type="submit">Send invitation</button>
                            <p class="muted small" data-form-status style="margin:12px 0 0"></p>
                        </form>
                    </article>
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Plan Limits</h2><span class="badge warning">Controlled by pricing</span></div>
                        <div class="card-body">
                            <p class="muted small">Member and repository limits are enforced from the selected pricing plan.</p>
                        </div>
                    </article>
                </section>
                <section class="card" style="margin-top:18px">
                    <div class="card-header"><h2 class="card-title">Members</h2><span class="badge brand">/api/user/team/members</span></div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th></tr></thead>
                            <tbody data-api-table="team-members">
                                <tr><td colspan="5">Loading team members...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
