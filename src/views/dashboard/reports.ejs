<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'reports' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Exports and trend' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div><h2>Security reports</h2><p class="muted">Generate JSON exports and track score movement over time.</p></div>
                    <button class="button primary" type="button" data-report-export>Export JSON report</button>
                </section>
                <section class="grid grid-2">
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Security Trend</h2><span class="badge brand">/api/user/security-trend</span></div>
                        <div class="card-body">
                            <div class="trend-bars" data-api-trend>
                                <span style="height:42%"></span><span style="height:55%"></span><span style="height:60%"></span><span style="height:48%"></span><span style="height:72%"></span><span style="height:86%"></span>
                            </div>
                        </div>
                    </article>
                    <article class="card">
                        <div class="card-header"><h2 class="card-title">Report Sections</h2><span class="badge success">Ready</span></div>
                        <div class="card-body checklist">
                            <label><input type="checkbox" checked> Repository posture</label>
                            <label><input type="checkbox" checked> Open findings</label>
                            <label><input type="checkbox" checked> Ignored rules</label>
                            <label><input type="checkbox" checked> Audit activity</label>
                        </div>
                    </article>
                </section>
                <section class="card" style="margin-top:18px">
                    <div class="card-header"><h2 class="card-title">Export Preview</h2></div>
                    <pre class="code-preview" data-report-preview>{ "status": "ready", "format": "json", "scope": "tenant" }</pre>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
