<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'dashboard' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Security workspace' }) %>
            <main class="content">
                <div class="card card-body github-callback-status" data-github-callback-status hidden style="margin-bottom:18px"></div>
                <section class="grid grid-4">
                    <article class="card card-body">
                        <span class="badge brand">Repositories</span>
                        <div class="metric-value" data-dashboard-metric="repositories">--</div>
                        <div class="metric-label">connected through the GitHub App</div>
                    </article>
                    <article class="card card-body">
                        <span class="badge danger">Critical</span>
                        <div class="metric-value" data-dashboard-metric="criticalFindings">--</div>
                        <div class="metric-label">open findings that need owner review</div>
                    </article>
                    <article class="card card-body">
                        <span class="badge warning">Queue</span>
                        <div class="metric-value" data-dashboard-metric="queuedScans">--</div>
                        <div class="metric-label">scans waiting or currently running</div>
                    </article>
                    <article class="card card-body">
                        <span class="badge success">Score</span>
                        <div class="metric-value" data-dashboard-metric="averageScore">--</div>
                        <div class="metric-label">average security score this week</div>
                    </article>
                </section>

                <section class="grid grid-3" style="margin-top:18px">
                    <article class="card span-2" id="findings">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">Risk Overview</h2>
                                <p class="muted small" style="margin:4px 0 0">Finding volume grouped by scanner category.</p>
                            </div>
                            <button class="button" type="button" data-report-export>Export report</button>
                        </div>
                        <div class="card-body">
                            <div data-dashboard-risk>
                                <div class="empty-state">Run a repository scan to build your risk overview.</div>
                            </div>
                        </div>
                    </article>

                    <article class="card">
                        <div class="card-header">
                            <h2 class="card-title">GitHub App Health</h2>
                            <span class="badge brand">GitHub</span>
                        </div>
                        <div class="card-body">
                            <div class="github-account" data-dashboard-github-account hidden>
                                <span class="github-logo" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.3-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.2-3.08-.12-.3-.52-1.51.12-3.04 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.82 0c2.22-1.5 3.2-1.18 3.2-1.18.64 1.53.24 2.74.12 3.04.75.8 1.2 1.83 1.2 3.08 0 4.42-2.7 5.38-5.26 5.67.42.36.78 1.06.78 2.14v3.15c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
                                </span>
                                <div><a href="https://github.com" target="_blank" rel="noopener noreferrer" data-dashboard-github-link style="color:var(--text);font-weight:800;text-decoration:none"><strong data-dashboard-github-login>GitHub connected</strong></a><p class="muted small" data-dashboard-github-meta style="margin:3px 0 0">Selected repository access</p></div>
                            </div>
                            <p class="muted small" data-dashboard-github-health>Install the GitHub App and select repositories to start sync and scanning.</p>
                            <a class="button primary" href="/repositories" style="width:100%;margin-top:12px">Open GitHub setup</a>
                        </div>
                    </article>
                </section>

                <section class="grid" style="margin-top:18px">
                    <article class="card" id="repositories">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">Repositories</h2>
                                <p class="muted small" style="margin:4px 0 0">Recent repositories with scan or sync activity.</p>
                            </div>
                            <a class="button" href="/repositories">View all repositories</a>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr><th>Repository</th><th>Provider</th><th>Default Branch</th><th>Score</th><th>Status</th><th></th></tr>
                                </thead>
                                <tbody data-api-table="repositories" data-dashboard-repositories>
                                    <tr><td colspan="6">Loading repositories...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </article>
                </section>

                <section class="grid" style="margin-top:18px">
                    <article class="card" id="reports">
                        <div class="card-header">
                            <h2 class="card-title">Latest Findings</h2>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr><th>Finding</th><th>Severity</th><th>Mitigation</th></tr>
                                </thead>
                                <tbody data-api-table="latest-findings">
                                    <tr><td colspan="3">Run a scan to load findings.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </article>
                </section>

                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
