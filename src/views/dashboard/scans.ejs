<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'scans' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Scan history' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Repository scans</h2>
                        <p class="muted">Review queued, running, completed, and failed scans across your connected repositories.</p>
                    </div>
                    <a class="button primary" href="/repositories">Choose repository to scan</a>
                </section>

                <section class="card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Scan Runs</h2>
                            <p class="muted small" style="margin:4px 0 0">Loaded from your workspace scan history.</p>
                        </div>
                        <span class="badge brand" data-scan-total>0 scans</span>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr><th>ID</th><th>Repository</th><th>Status</th><th>Trigger</th><th>Findings</th><th>Completed</th><th></th></tr>
                            </thead>
                            <tbody data-api-table="scans">
                                <tr><td colspan="7">Loading scans...</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="table-pagination" data-scan-pagination>
                        <span class="muted small" data-scan-page-summary>Loading scans...</span>
                        <div class="toolbar-actions">
                            <button class="button" type="button" data-scan-page="prev" disabled>Previous</button>
                            <button class="button" type="button" data-scan-page="next" disabled>Next</button>
                        </div>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
