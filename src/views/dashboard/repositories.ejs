<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'repositories' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'Code hosts' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Connected repositories</h2>
                        <p class="muted">Sync providers, review repository scores, and start manual scans.</p>
                    </div>
                    <div class="toolbar-actions">
                        <button class="button" type="button" data-provider-connect="github">GitHub</button>
                        <button class="button" type="button" data-provider-connect="gitlab">GitLab</button>
                        <button class="button primary" type="button" data-provider-connect="bitbucket">Bitbucket</button>
                    </div>
                </section>

                <section class="grid grid-3">
                    <article class="card card-body provider-card">
                        <span class="provider-icon">GH</span>
                        <div><strong>GitHub</strong><p class="muted small">App installation and webhook sync</p></div>
                    </article>
                    <article class="card card-body provider-card">
                        <span class="provider-icon">GL</span>
                        <div><strong>GitLab</strong><p class="muted small">OAuth connection and project sync</p></div>
                    </article>
                    <article class="card card-body provider-card">
                        <span class="provider-icon">BB</span>
                        <div><strong>Bitbucket</strong><p class="muted small">Workspace repositories and webhooks</p></div>
                    </article>
                </section>

                <section class="card" style="margin-top:18px">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Repository Inventory</h2>
                            <p class="muted small" style="margin:4px 0 0">Loaded from <code>/api/user/repositories</code> when a session token is present.</p>
                        </div>
                        <div class="segmented">
                            <button class="active" type="button">All</button>
                            <button type="button">Critical</button>
                            <button type="button">Healthy</button>
                        </div>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Repository</th><th>Provider</th><th>Default Branch</th><th>Score</th><th>Status</th><th></th></tr></thead>
                            <tbody data-api-table="repositories">
                                <tr><td>checkout-api</td><td>GitHub</td><td>main</td><td>91</td><td><span class="badge success">Healthy</span></td><td><button class="button">Scan</button></td></tr>
                                <tr><td>customer-portal</td><td>GitLab</td><td>main</td><td>78</td><td><span class="badge warning">Review</span></td><td><button class="button">Scan</button></td></tr>
                                <tr><td>infra-deploy</td><td>Bitbucket</td><td>master</td><td>64</td><td><span class="badge danger">Critical</span></td><td><button class="button">Scan</button></td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
