<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell">
        <%- include('../partials/sidebar', { appName, activePage: 'repositories' }) %>
        <div class="main-area">
            <%- include('../partials/navbar', { title, appName, eyebrow: 'GitHub repositories' }) %>
            <main class="content">
                <section class="page-toolbar">
                    <div>
                        <h2>Connected repositories</h2>
                        <p class="muted">Install the GitHub App, review repository scores, and start manual scans.</p>
                    </div>
                    <div class="toolbar-actions">
                        <button class="button primary" type="button" data-provider-connect="github">Install GitHub App</button>
                    </div>
                </section>

                <section class="grid grid-3">
                    <article class="card card-body provider-card">
                        <span class="provider-icon">GH</span>
                        <div><strong>GitHub App</strong><p class="muted small">Selected repository access, installation sync, and push webhooks.</p></div>
                    </article>
                </section>

                <section class="card" style="margin-top:18px">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Repository Inventory</h2>
                            <p class="muted small" style="margin:4px 0 0">Loaded from <code>/api/user/repositories</code> when a session token is present.</p>
                        </div>
                        <div class="segmented">
                            <button class="active" type="button">All</button>
                            <button type="button">Critical</button>
                            <button type="button">Healthy</button>
                        </div>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Repository</th><th>Provider</th><th>Default Branch</th><th>Score</th><th>Status</th><th></th></tr></thead>
                            <tbody data-api-table="repositories">
                                <tr><td colspan="6">Loading repositories...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
