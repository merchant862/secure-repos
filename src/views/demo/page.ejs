<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body>
    <div class="app-shell demo-shell">
        <aside class="sidebar">
            <a class="brand" href="/demo" aria-label="Demo dashboard">
                <%- include('../partials/brand-logo') %>
            </a>
            <nav aria-label="Demo">
                <div class="nav-section">Demo App</div>
                <a class="nav-link <%= page === 'dashboard' ? 'active' : '' %>" href="/demo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>Dashboard</a>
                <a class="nav-link <%= page === 'repositories' ? 'active' : '' %>" href="/demo/repositories"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>Repositories</a>
                <a class="nav-link <%= page === 'findings' ? 'active' : '' %>" href="/demo/findings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 9v4M12 17h.01"/></svg>Findings</a>
                <div class="nav-section">Setup</div>
                <a class="nav-link <%= page === 'onboarding' ? 'active' : '' %>" href="/demo/onboarding"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Onboarding</a>
                <a class="nav-link <%= page === 'billing' ? 'active' : '' %>" href="/demo/billing"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Billing</a>
                <a class="nav-link <%= page === 'settings' ? 'active' : '' %>" href="/demo/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83"/></svg>Settings</a>
                <a class="nav-link <%= page === 'notifications' ? 'active' : '' %>" href="/demo/notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>Notifications</a>
            </nav>
        </aside>
        <div class="overlay" data-sidebar-overlay></div>
        <div class="main-area">
            <%- include('../partials/navbar', { title: pageTitle, appName, eyebrow: 'Interactive demo', demoMode: true }) %>
            <main class="content">
                <section class="demo-notice"><span class="badge brand">Demo data</span><p>This public demo uses sample data only. Create an account to connect real GitHub repositories.</p><a class="button primary" href="/sign-up">Create account</a></section>

                <% if (page === 'dashboard') { %>
                    <section class="grid grid-4">
                        <article class="card card-body"><span class="badge brand">Repositories</span><div class="metric-value">18</div><div class="metric-label">connected repos</div></article>
                        <article class="card card-body"><span class="badge danger">Critical</span><div class="metric-value">7</div><div class="metric-label">open findings</div></article>
                        <article class="card card-body"><span class="badge warning">Queue</span><div class="metric-value">4</div><div class="metric-label">active scans</div></article>
                        <article class="card card-body"><span class="badge success">Score</span><div class="metric-value">86</div><div class="metric-label">weekly posture</div></article>
                    </section>
                    <section class="grid grid-2" style="margin-top:18px"><article class="card"><div class="card-header"><h2 class="card-title">Risk Overview</h2><span class="badge brand">Scanner categories</span></div><div class="card-body"><div class="progress-row"><span>Secrets</span><div class="progress"><span style="width:72%"></span></div><strong>18</strong></div><div class="progress-row"><span>GitHub Actions</span><div class="progress"><span style="width:46%"></span></div><strong>9</strong></div><div class="progress-row"><span>Docker</span><div class="progress"><span style="width:35%"></span></div><strong>6</strong></div></div></article><article class="card"><div class="card-header"><h2 class="card-title">GitHub App Health</h2><span class="badge success">Online</span></div><div class="card-body"><div class="progress-row"><span>Installation</span><div class="progress"><span style="width:100%"></span></div><strong>OK</strong></div><div class="progress-row"><span>Selected repos</span><div class="progress"><span style="width:82%"></span></div><strong>18</strong></div><div class="progress-row"><span>Webhook sync</span><div class="progress"><span style="width:92%"></span></div><strong>On</strong></div></div></article></section>
                <% } else if (page === 'repositories') { %>
                    <section class="card"><div class="card-header"><h2 class="card-title">Repository Inventory</h2><span class="badge success">Synced</span></div><div class="table-wrap"><table><thead><tr><th>Repository</th><th>Provider</th><th>Branch</th><th>Score</th><th>Status</th></tr></thead><tbody><tr><td>storefront-web</td><td>GitHub</td><td>main</td><td>91</td><td><span class="badge success">Healthy</span></td></tr><tr><td>customer-portal</td><td>GitHub</td><td>main</td><td>78</td><td><span class="badge warning">Review</span></td></tr><tr><td>infra-deploy</td><td>GitHub</td><td>main</td><td>64</td><td><span class="badge danger">Critical</span></td></tr></tbody></table></div></section>
                <% } else if (page === 'findings') { %>
                    <section class="card"><div class="card-header"><h2 class="card-title">Open Findings</h2><span class="badge danger">20 open</span></div><div class="finding-list"><article class="finding-item"><span class="badge danger">Critical</span><div><strong>Possible secret token in config file</strong><p class="muted small">storefront-web / src/config/payment.ts</p></div><div class="row-actions"><button class="button">Resolve</button></div></article><article class="finding-item"><span class="badge warning">High</span><div><strong>GitHub Actions workflow grants write-all permissions</strong><p class="muted small">customer-portal / .github/workflows/deploy.yml</p></div><div class="row-actions"><button class="button">Snooze</button><button class="button">Resolve</button></div></article></div></section>
                <% } else if (page === 'billing') { %>
                    <section class="grid grid-2"><article class="card"><div class="card-header"><h2 class="card-title">Selected Package</h2><span class="badge success">SecureRepos</span></div><div class="card-body"><div class="billing-plan-summary"><div class="metric-value">Monthly</div><p class="muted">The live price and configured limits are shown at checkout.</p><div class="plan-detail-grid"><span><strong>Configured limit</strong><small>Repository coverage</small></span><span><strong>Scheduled</strong><small>Scan cadence</small></span><span><strong>Retained</strong><small>Finding history</small></span></div><ul class="plan-list compact"><li>Critical and high email alerts</li><li>Dependency CVE checks</li><li>Branch-level findings</li></ul></div></div></article><article class="card"><div class="card-header"><h2 class="card-title">Checkout Status</h2><span class="badge brand">Checkout ready</span></div><div class="card-body"><p class="muted">Card collection will happen inside the selected checkout provider.</p><button class="button primary" disabled>Checkout pending</button></div></article></section><section class="card" style="margin-top:18px"><div class="card-header"><h2 class="card-title">Subscription Controls</h2><span class="badge warning">Owner only</span></div><div class="card-body"><div class="billing-payment-method"><div><strong>Payment method</strong><p class="muted small">Visa ending in 4242 · expires 12/2028. Updates happen securely on Paddle.</p></div><button class="button" type="button" disabled>Update payment method</button></div><p class="muted">Cancel future renewals from this page. Access remains subject to the current billing period and Paddle status.</p><button class="button danger" type="button" disabled>Cancel subscription</button></div></section>
                <% } else if (page === 'settings') { %>
                    <section class="card"><div class="card-header"><h2 class="card-title">Change Password</h2><span class="badge brand">Account security</span></div><div class="card-body"><div class="form-field"><label>Current password</label><div class="password-field"><input class="input" type="password" value="current-password" readonly><button class="button compact" type="button" data-password-toggle>Show</button></div></div><div class="grid grid-2"><div class="form-field"><label>New password</label><div class="password-field"><input class="input" type="password" value="new-password-value" readonly><button class="button compact" type="button" data-password-toggle>Show</button></div></div><div class="form-field"><label>Confirm new password</label><div class="password-field"><input class="input" type="password" value="new-password-value" readonly><button class="button compact" type="button" data-password-toggle>Show</button></div></div></div><button class="button primary" type="button" disabled>Update password</button></div></section>
                    <section class="card" style="margin-top:18px"><div class="card-header"><h2 class="card-title">Audit Log</h2></div><div class="table-wrap"><table><thead><tr><th>Action</th><th>Entity</th><th>Time</th></tr></thead><tbody><tr><td>repository.scan.completed</td><td>storefront-web</td><td>2 minutes ago</td></tr><tr><td>subscription.activated</td><td>SecureRepos</td><td>Yesterday</td></tr></tbody></table></div></section>
                <% } else if (page === 'notifications') { %>
                    <section class="card"><div class="card-header"><h2 class="card-title">Recent Notifications</h2><span class="badge brand">Realtime-ready</span></div><div class="finding-list"><article class="finding-item"><span class="badge danger">New</span><div><strong>Critical finding opened</strong><p class="muted small">storefront-web produced a critical result.</p></div><button class="button">Mark read</button></article><article class="finding-item"><span class="badge warning">Scan</span><div><strong>Scan completed</strong><p class="muted small">customer-portal finished with new findings to review.</p></div><button class="button">Open</button></article></div></section>
                <% } else { %>
                    <section class="onboarding-steps"><article class="card card-body step-card active"><span class="step-number">1</span><strong>Verify account</strong><p class="muted small">Confirm the registered email address.</p></article><article class="card card-body step-card"><span class="step-number">2</span><strong>Hosted checkout</strong><p class="muted small">Start the Security Preview through Paddle.</p></article><article class="card card-body step-card"><span class="step-number">3</span><strong>Install GitHub App</strong><p class="muted small">Select one preview repository.</p></article><article class="card card-body step-card"><span class="step-number">4</span><strong>Preview scan</strong><p class="muted small">Review limited findings before paid access begins.</p></article></section>
                <% } %>
                <%- include('../partials/footer') %>
            </main>
        </div>
    </div>
    <script src="/public/js/app.js"></script>
</body>
</html>
