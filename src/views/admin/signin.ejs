<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body>
    <main class="auth-shell admin-auth-shell">
        <section class="auth-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div>
                <h1 style="font-size:42px;line-height:1.08;margin:0 0 16px">Secure Repos admin control.</h1>
                <p style="color:#d0d5dd;max-width:560px">Manage plans, tenants, repositories, scans, provider settings, and admin accounts from one operational console.</p>
            </div>
            <p style="color:#98a2b3;margin:0">Admin accounts are created only through the seed command.</p>
        </section>
        <section class="auth-card">
            <div class="auth-card-inner">
                <a class="muted small" href="/">Back to site</a>
                <h1 style="margin:22px 0 8px">Admin sign in</h1>
                <p class="muted" style="margin:0 0 26px">Use an admin account created with <code>npm run seed:admin</code>.</p>
                <form data-admin-login>
                    <div class="form-field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" autocomplete="email" required>
                    </div>
                    <div class="form-field">
                        <label>Password</label>
                        <input class="input" type="password" name="password" autocomplete="current-password" required>
                    </div>
                    <button class="button primary" type="submit" style="width:100%">Sign in</button>
                    <p class="muted small" data-admin-status style="margin:12px 0 0"></p>
                </form>
            </div>
        </section>
    </main>
    <script src="/public/js/admin.js"></script>
</body>
</html>
