<header class="topbar">
    <div class="topbar-left">
        <button class="icon-button mobile-toggle" type="button" data-sidebar-toggle aria-label="Open sidebar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <div>
            <div class="page-eyebrow"><%= eyebrow || 'Workspace' %></div>
            <h1 class="page-title"><%= title || 'Dashboard' %></h1>
        </div>
    </div>
    <div class="topbar-actions">
        <div class="topbar-action-menu" data-mobile-header-menu>
            <div class="session-chip" data-session-summary hidden>
                <span class="session-chip-icon" data-session-device-icon aria-hidden="true"></span>
                <span class="session-chip-icon browser" data-session-browser-icon aria-hidden="true"></span>
                <span class="session-chip-copy">
                    <strong data-session-browser>Current browser</strong>
                    <small data-session-meta>Loading login device...</small>
                </span>
            </div>
            <% if (typeof showQuickSettings !== 'undefined' && showQuickSettings) { %>
                <button class="button compact" type="button" data-quick-settings-toggle>Quick settings</button>
                <div class="quick-settings-panel" data-quick-settings-panel>
                    <div class="card-header" style="padding:4px 4px 12px">
                        <h2 class="card-title">Quick Settings</h2>
                        <span class="badge brand">Owner</span>
                    </div>
                    <form class="settings-form" data-api-form="notification-settings" data-compact-settings>
                        <label><input type="checkbox" name="instantCritical"> Instant critical alerts</label>
                        <label><input type="checkbox" name="instantHigh"> Instant high alerts</label>
                        <label><input type="checkbox" name="dailyDigest"> Daily digest</label>
                        <label><input type="checkbox" name="weeklyReport"> Weekly report</label>
                        <button class="button primary" type="submit">Save preferences</button>
                        <p class="muted small" data-form-status style="margin:0"></p>
                    </form>
                </div>
            <% } %>
            <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle theme">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v2M12 19v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M3 12h2M19 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/><circle cx="12" cy="12" r="4"/></svg>
            </button>
            <button class="icon-button" type="button" data-notification-toggle aria-label="Notifications">
                <span class="badge danger" style="position:absolute;margin:-30px 0 0 30px;padding:2px 6px" data-unread-count>0</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </button>
            <div class="notification-panel" data-notification-panel>
                <div class="card-header" style="padding:4px 4px 12px">
                    <h2 class="card-title">Notifications</h2>
                    <span class="badge brand">Live</span>
                </div>
                <div data-notification-list>
                    <div class="notification-item"><strong>Loading</strong><span>Fetching workspace notifications...</span></div>
                </div>
            </div>
            <a class="mobile-profile-link" href="/profile">Open profile</a>
        </div>
        <a class="profile-badge desktop-profile-badge" href="/profile" aria-label="Profile">
            <img src="/public/images/user/owner.jpg" alt="" width="36" height="36" style="border-radius:999px;border:1px solid var(--border)">
        </a>
        <button class="profile-badge mobile-profile-badge" type="button" data-mobile-header-toggle aria-label="Open account menu" aria-expanded="false">
            <img src="/public/images/user/owner.jpg" alt="" width="36" height="36" style="border-radius:999px;border:1px solid var(--border)">
        </button>
    </div>
</header>
