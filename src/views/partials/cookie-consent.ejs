<section class="cookie-consent" data-cookie-consent hidden aria-live="polite">
    <div class="cookie-copy">
        <span class="badge brand">Cookie preferences</span>
        <h2>Choose how SecureRepos uses cookies.</h2>
        <p class="muted small">Necessary cookies keep the site and sign-in working. You can also allow preference, analytics, and marketing cookies.</p>
    </div>
    <div class="cookie-options">
        <label class="cookie-option locked">
            <input type="checkbox" checked disabled>
            <span><strong>Necessary</strong><small>Required for security, sessions, and basic site behavior.</small></span>
        </label>
        <label class="cookie-option">
            <input type="checkbox" name="preferences" data-cookie-choice="preferences">
            <span><strong>Preferences</strong><small>Remember UI choices like theme and display settings.</small></span>
        </label>
        <label class="cookie-option">
            <input type="checkbox" name="analytics" data-cookie-choice="analytics">
            <span><strong>Analytics</strong><small>Help us understand page performance and product interest.</small></span>
        </label>
        <label class="cookie-option">
            <input type="checkbox" name="marketing" data-cookie-choice="marketing">
            <span><strong>Marketing</strong><small>Support attribution and campaign measurement if enabled later.</small></span>
        </label>
    </div>
    <div class="cookie-actions">
        <button class="button" type="button" data-cookie-action="necessary">Necessary only</button>
        <button class="button" type="button" data-cookie-action="save">Save choices</button>
        <button class="button primary" type="button" data-cookie-action="all">Accept all</button>
    </div>
</section>
