<!doctype html>
<html lang="en">
<head>
    <%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %>
</head>
<body data-force-theme="dark">
    <main class="checkout-shell">
        <section class="checkout-copy">
            <a class="brand" href="/" style="padding:0;color:#fff"><%- include('../partials/brand-logo') %></a>
            <div>
                <span class="badge brand">Secure checkout</span>
                <h1>Start your SecureRepos Security Preview.</h1>
                <p>Confirm your payment method with Paddle. Your 7-day preview starts immediately and paid billing begins automatically when it ends unless you cancel.</p>
                <div class="checkout-assurance">
                    <span>SecureRepos never collects or stores card numbers.</span>
                    <span>The first preview repository stays tied to this workspace.</span>
                    <span>Full scanning unlocks only after the selected plan activates.</span>
                </div>
            </div>
            <div class="checkout-steps">
                <article><span>1</span><strong>Account</strong><p>Your workspace is created first.</p></article>
                <article><span>2</span><strong>Payment method</strong><p>Paddle securely handles card collection and future billing.</p></article>
                <article><span>3</span><strong>GitHub</strong><p>Permanently connect one GitHub account and choose one preview repository.</p></article>
            </div>
        </section>
        <section class="checkout-panel">
            <% if (checkoutError) { %>
                <div class="card card-body">
                    <span class="badge danger">Checkout unavailable</span>
                    <h2>Payment setup needs attention</h2>
                    <p class="muted"><%= checkoutError %></p>
                    <a class="button" href="/checkout">Choose another plan</a>
                </div>
            <% } else if (!user) { %>
                <div class="card card-body">
                    <span class="badge warning">Account required</span>
                    <h2>Create your account before checkout</h2>
                    <p class="muted">SecureRepos needs a workspace before Paddle can attach the subscription to your account.</p>
                    <div class="row-actions">
                        <a class="button primary" href="/sign-up?t=<%= encodeURIComponent(checkoutToken) %>">Create account</a>
                        <a class="button" href="/sign-in?next=<%= encodeURIComponent('/checkout?t=' + checkoutToken) %>">Sign in</a>
                    </div>
                </div>
            <% } else { %>
                <div class="card checkout-card">
                    <div class="card-header">
                        <div>
                            <span class="badge success"><%= checkoutConfig.plan.name %></span>
                            <h2 class="card-title">Complete checkout</h2>
                        </div>
                        <strong><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: checkoutConfig.plan.currency || 'USD' }).format(Number(checkoutConfig.plan.priceMonthlyCents || 0) / 100) %>/mo</strong>
                    </div>
                    <div class="card-body">
                        <div data-paddle-checkout>
                            <script type="application/json" data-paddle-config><%- JSON.stringify(checkoutConfig).replace(/</g, '\\u003c') %></script>
                            <div class="paddle-checkout-frame" data-paddle-frame>
                                <div class="empty-state">Loading secure checkout...</div>
                            </div>
                        </div>
                        <p class="muted small">The preview includes one repository and one limited scan with up to five sample findings. No card data is collected by SecureRepos; Paddle handles checkout. Full access starts only after the trial converts to the paid subscription.</p>
                    </div>
                </div>
            <% } %>
        </section>
    </main>
    <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
    <script src="/public/js/app.js"></script>
</body>
</html>
