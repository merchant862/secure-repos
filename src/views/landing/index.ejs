<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body data-force-theme="dark">
    <main class="landing-shell">
        <nav class="landing-nav">
            <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
            <div class="landing-nav-links">
                <a href="#platform">Scans</a>
                <a href="#workflow">How it works</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
            </div>
            <div class="toolbar-actions landing-nav-actions"><a class="button" href="/sign-in">Sign in</a><a class="button primary" href="/sign-up">Create account</a></div>
            <button class="landing-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-landing-menu-toggle>
                <span></span><span></span><span></span>
            </button>
            <div class="landing-mobile-menu" data-landing-menu>
                <a href="#platform">Scans</a>
                <a href="#workflow">How it works</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
                <div class="landing-mobile-actions">
                    <a class="button" href="/sign-in">Sign in</a>
                    <a class="button primary" href="/sign-up">Create account</a>
                </div>
            </div>
        </nav>
        <section class="landing-hero">
            <div class="landing-hero-copy">
                <span class="badge brand">GitHub security for independent developers</span>
                <h1>Know what is hiding in your repositories before it ships.</h1>
                <p class="muted">SecureRepos checks supported files across active branches for exposed secrets, risky GitHub Actions, unsafe configuration, Docker issues, and dependency concerns. You get clear findings and practical next steps, without an enterprise security stack.</p>
                <div class="toolbar-actions" style="justify-content:flex-start"><a class="button primary" href="/sign-up">Scan my repositories</a><a class="button" href="/demo">See a real dashboard</a></div>
                <div class="landing-trust-row">
                    <span>GitHub App</span>
                    <span>Branch-wide coverage</span>
                    <span>No card required to view demo</span>
                </div>
            </div>
            <div class="landing-visual-column">
                <div class="security-animation" aria-hidden="true">
                    <div class="security-grid"></div>
                    <div class="security-shield"><span></span></div>
                    <div class="security-scan-line"></div>
                    <div class="security-code-stream">
                        <span>token_scan</span>
                        <span>ci_guard</span>
                        <span>secret_match</span>
                    </div>
                </div>
            <div class="demo-frame">
                <div class="demo-top"><span></span><span></span><span></span></div>
                <div class="demo-frame-header">
                    <div><strong>Security overview</strong><p class="muted small">The repositories that need attention today</p></div>
                    <span class="badge success">86 score</span>
                </div>
                <div class="landing-demo-focus">
                    <span class="badge danger">Needs attention</span>
                    <strong>One exposed token and two unsafe workflow permissions.</strong>
                    <p class="muted small">Each finding includes the branch, file, severity, and a practical remediation path.</p>
                </div>
                <div class="landing-demo-progress">
                    <div><strong>74%</strong><span>repository health</span></div>
                    <div class="progress"><span style="width:74%"></span></div>
                </div>
                <div class="landing-demo-list">
                    <article><span class="badge brand">Secrets</span><p>API token pattern detected in checkout config</p></article>
                    <article><span class="badge warning">CI</span><p>Workflow grants broad write permissions</p></article>
                    <article><span class="badge success">Report</span><p>Branch-level scan report ready to export</p></article>
                </div>
            </div>
            </div>
        </section>
        <section class="landing-band landing-band-dark" id="platform">
            <div class="landing-section-heading">
                <span class="badge brand">What it checks</span>
                <h2>Useful checks for the code and configuration solo developers actually ship.</h2>
                <p class="muted">Install the GitHub App, choose repositories within your plan, and review findings by repository and branch.</p>
            </div>
            <div class="grid grid-3 landing-features">
                <article class="landing-feature-card"><span>01</span><strong>Secrets and credentials</strong><p class="muted small">Catch common API keys, private keys, database URLs, and hardcoded credentials before they become incidents.</p></article>
                <article class="landing-feature-card"><span>02</span><strong>CI and configuration</strong><p class="muted small">Review broad workflow permissions, unsafe scripts, risky Docker settings, and repository hygiene.</p></article>
                <article class="landing-feature-card"><span>03</span><strong>Branch-level reports</strong><p class="muted small">See which branch and file produced a finding, then export the scan as JSON or XLSX.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-light">
            <div class="landing-section-heading">
                <span class="badge success">Built to stay manageable</span>
                <h2>Security checks that fit around the way you already use GitHub.</h2>
            </div>
            <div class="landing-experience-grid">
                <article><strong>You choose the repositories</strong><p>Connect only the projects covered by your plan. SecureRepos does not need access to everything in your GitHub account.</p></article>
                <article><strong>Findings stay understandable</strong><p>Severity, affected branch, file path, and remediation guidance are kept together.</p></article>
                <article><strong>Limits stay predictable</strong><p>Repository and scan limits are clear in each plan. There are no unlimited tiers hiding infrastructure restrictions.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-dark" id="workflow">
            <div class="landing-section-heading">
                <span class="badge brand">How it works</span>
                <h2>From GitHub install to a useful report in four steps.</h2>
            </div>
            <div class="landing-step-grid">
                <article><span>1</span><strong>Create your account</strong><p class="muted small">Choose the plan that matches the number of repositories you actively maintain.</p></article>
                <article><span>2</span><strong>Install the GitHub App</strong><p class="muted small">Select repositories within your package limit and keep access scoped.</p></article>
                <article><span>3</span><strong>Review active branches</strong><p class="muted small">Each scan supports up to 50 branches and 2,000 scannable files per repository to keep scan time and GitHub API usage predictable.</p></article>
                <article><span>4</span><strong>Fix and verify</strong><p class="muted small">Follow remediation guidance, rerun the scan, and export the result when needed.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-pricing" id="pricing">
            <div class="landing-section-heading">
                <span class="badge warning">Pricing</span>
                <h2>Two plans, both built for solo developers.</h2>
                <p class="muted">Choose based on the repositories you maintain and how often you want automatic checks to run.</p>
            </div>
            <div class="landing-pricing-grid" data-public-pricing>
                <article class="card card-body plan-card"><p class="muted">Loading current plans...</p></article>
            </div>
        </section>
        <section class="landing-access" id="access">
            <div>
                <span class="badge warning">Access model</span>
                <h2>See the product before you connect a repository.</h2>
                <p class="muted">The public demo shows the dashboard and finding workflow without GitHub access. When you are ready, create an account, activate a plan, and install the GitHub App.</p>
            </div>
            <div class="landing-access-actions">
                <a class="button primary" href="/sign-up">Create account</a>
                <a class="button" href="/demo">Open demo</a>
            </div>
        </section>
        <footer class="landing-footer">
            <div class="landing-footer-brand">
                <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
                <p class="muted small">GitHub repository security scanning, branch-level findings, practical remediation, and exportable reports for independent developers.</p>
                <div class="payment-marks" aria-label="Accepted payment methods">
                    <span class="payment-mark visa">VISA</span>
                    <span class="payment-mark mastercard"><i></i><b></b></span>
                    <span class="payment-mark amex">AMEX</span>
                    <span class="payment-mark discover">DISCOVER</span>
                    <span class="payment-mark diners">DINERS</span>
                    <span class="payment-mark jcb">JCB</span>
                    <span class="payment-mark unionpay">UP</span>
                    <span class="payment-mark maestro">MAESTRO</span>
                    <span class="payment-mark elo">ELO</span>
                </div>
            </div>
            <div class="landing-footer-grid">
                <div>
                    <h3>Product</h3>
                    <a href="/demo">Demo</a>
                    <a href="#platform">Scans</a>
                    <a href="#workflow">Workflow</a>
                    <a href="#pricing">Pricing</a>
                    <a href="/faqs">FAQ</a>
                </div>
                <div>
                    <h3>Account</h3>
                    <a href="/sign-in">Sign in</a>
                    <a href="/sign-up">Create account</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h3>Legal</h3>
                    <a href="/terms">Terms</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/refund-policy">Refund Policy</a>
                    <a href="/do-not-sell">Do Not Sell/Share</a>
                </div>
            </div>
        </footer>
        <div class="landing-footer-bottom">
            <span>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
            <span>Hosted card checkout will be handled by the selected payment provider.</span>
        </div>
        <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5l7 7-1.4 1.4-4.6-4.6V20h-2V8.8l-4.6 4.6L5 12l7-7z"></path></svg>
        </button>
        <%- include('../partials/cookie-consent') %>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
