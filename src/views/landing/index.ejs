<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body data-force-theme="dark">
    <main class="landing-shell sec-site">
        <nav class="landing-nav sec-nav">
            <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
            <div class="landing-nav-links">
                <a href="#coverage">Coverage</a>
                <a href="#packages">Packages</a>
                <a href="#agents">Agents</a>
                <a href="#workflow">Workflow</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
            </div>
            <div class="toolbar-actions landing-nav-actions"><a class="button" href="/sign-in">Sign in</a><a class="button primary" href="/sign-up">Create account</a></div>
            <button class="landing-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-landing-menu-toggle>
                <span></span><span></span><span></span>
            </button>
            <div class="landing-mobile-menu" data-landing-menu>
                <span class="mobile-menu-label">Navigation</span>
                <a href="#coverage">Coverage</a>
                <a href="#packages">Packages</a>
                <a href="#agents">Agents</a>
                <a href="#workflow">Workflow</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <div class="landing-mobile-actions">
                    <a class="button" href="/sign-in">Sign in</a>
                    <a class="button primary" href="/sign-up">Create account</a>
                </div>
            </div>
        </nav>

        <section class="sec-hero">
            <div class="sec-hero-copy">
                <p class="sec-kicker">GitHub repository security scanner</p>
                <h1>Catch repo risk before it reaches production.</h1>
                <p class="sec-lede">SecureRepos monitors selected GitHub repositories and turns secrets, vulnerable packages, CI/CD, Docker, and IaC signals into clear findings for your dashboard, terminal, and coding agent.</p>
                <div class="sec-actions">
                    <a class="button primary" href="/sign-up">Start security preview</a>
                    <a class="button" href="/demo">Open demo</a>
                </div>
            </div>
            <div class="sec-hero-visual" aria-label="SecureRepos scan preview">
                <div class="sec-dashboard-preview">
                    <div class="sec-preview-top">
                        <span></span><span></span><span></span>
                        <strong>SecureRepos scan</strong>
                    </div>
                    <div class="sec-preview-repo">
                        <div>
                            <small>Repository</small>
                            <strong>merchant/checkout-api</strong>
                        </div>
                        <span>scan complete</span>
                    </div>
                    <div class="sec-preview-body">
                        <div class="sec-preview-score">
                            <span>3</span>
                            <p>findings need review</p>
                        </div>
                        <div class="sec-preview-findings">
                            <article><b>Critical</b><span>credential-like value in production config</span></article>
                            <article><b>High</b><span>workflow permission is broader than needed</span></article>
                            <article><b>Package</b><span>lockfile contains vulnerable dependency version</span></article>
                        </div>
                    </div>
                    <div class="sec-preview-footer">
                        <span><b></b> queued</span>
                        <span><b></b> scanning</span>
                        <span><b></b> parsed</span>
                        <span><b></b> notified</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="sec-logo-marquee" aria-label="Supported languages and ecosystems">
            <p>First-class dependency extraction where lockfiles exist. Broad source and config checks across common text files.</p>
            <div class="sec-marquee-track">
                <% const languageLogos = [
                    ['javascript', 'JavaScript'], ['typescript', 'TypeScript'], ['nodedotjs', 'Node.js'], ['php', 'PHP'],
                    ['python', 'Python'], ['rust', 'Rust'], ['ruby', 'Ruby'], ['go', 'Go'], ['dotnet', '.NET'],
                    ['openjdk', 'Java'], ['kotlin', 'Kotlin'], ['dart', 'Dart'], ['swift', 'Swift'], ['elixir', 'Elixir'],
                    ['r', 'R'], ['julia', 'Julia']
                ]; %>
                <% [...languageLogos, ...languageLogos].forEach(([slug, label]) => { %>
                    <span><img src="https://cdn.simpleicons.org/<%= slug %>" alt="" width="22" height="22" loading="lazy"><%= label %></span>
                <% }) %>
            </div>
        </section>

        <section class="sec-split" id="coverage">
            <div class="sec-section-copy">
                <p class="sec-kicker">Coverage</p>
                <h2>Focused checks, written for small teams and solo builders.</h2>
                <p>SecureRepos does not try to become a full enterprise security program. It watches the repository risks that usually break production trust first.</p>
            </div>
            <div class="sec-coverage-list">
                <article><span>01</span><strong>Secrets and credentials</strong><p>Tokens, keys, database URLs, private keys, and credential-like strings.</p></article>
                <article><span>02</span><strong>Beyond dependency alerts</strong><p>Dependency risk plus the repository context around secrets, CI/CD, config, containers, and IaC.</p></article>
                <article><span>03</span><strong>CI/CD and deployment config</strong><p>Workflow permissions, unsafe automation patterns, Docker, IaC, and deployment mistakes.</p></article>
                <article><span>04</span><strong>Evidence you can act on</strong><p>Repository, branch, severity, path, confidence, fix guidance, and alerts when it matters.</p></article>
            </div>
        </section>

        <section class="sec-dev-lane" id="packages">
            <div class="sec-section-copy">
                <p class="sec-kicker">npm packages</p>
                <h2>Dashboard visibility, terminal speed.</h2>
                <p>API tokens are short-lived and scoped to approved repositories. They cannot access billing, password, or account settings.</p>
            </div>
            <div class="sec-terminal-grid">
                <article>
                    <div><span>CLI</span><strong>@securerepos/cli</strong></div>
                    <pre><code><span>$ npm install -g @securerepos/cli</span><span>$ securerepos login</span><span>$ securerepos repos</span><span>$ securerepos scan --low-resource</span></code></pre>
                </article>
                <article>
                    <div><span>MCP</span><strong>@securerepos/mcp</strong></div>
                    <pre><code><span>{</span><span>  "mcpServers": {</span><span>    "securerepos": {</span><span>      "command": "npx",</span><span>      "args": ["@securerepos/mcp"],</span><span>      "env": { "SECUREREPOS_API_KEY": "srp_cli_xxxxx" }</span><span>    }</span><span>  }</span><span>}</span></code></pre>
                </article>
            </div>
        </section>

        <section class="sec-agents" id="agents">
            <div class="sec-section-copy">
                <p class="sec-kicker">Coding agents</p>
                <h2>Let your agent ask SecureRepos before it changes sensitive code.</h2>
            </div>
            <div class="sec-agent-stack">
                <div class="sec-agent-strip" aria-label="Compatible coding agents">
                    <span><img src="https://cdn.simpleicons.org/claudecode" alt="" width="24" height="24" loading="lazy">Claude Code</span>
                    <span><img src="/public/images/agent-logos/codex.svg" alt="" width="24" height="24" loading="lazy">Codex</span>
                    <span><img src="https://cdn.simpleicons.org/cursor" alt="" width="24" height="24" loading="lazy">Cursor</span>
                    <span><img src="https://cdn.simpleicons.org/windsurf" alt="" width="24" height="24" loading="lazy">Windsurf</span>
                    <span><img src="https://cdn.simpleicons.org/cline" alt="" width="24" height="24" loading="lazy">Cline</span>
                    <span><img src="https://cdn.simpleicons.org/zedindustries" alt="" width="24" height="24" loading="lazy">Zed</span>
                    <span><img src="https://cdn.simpleicons.org/githubcopilot" alt="" width="24" height="24" loading="lazy">Copilot</span>
                </div>
                <div class="sec-prompt-card">
                    <p>Suggested agent instruction</p>
                    <pre><code><span>Use SecureRepos before security-sensitive changes.</span><span>Scan the current Git repository.</span><span>Summarize critical and high findings first.</span><span>Do not change code until I confirm the fix.</span></code></pre>
                </div>
            </div>
        </section>

        <section class="sec-workflow" id="workflow">
            <div class="sec-section-copy">
                <p class="sec-kicker">Workflow</p>
                <h2>One clean path from signup to reviewed findings.</h2>
            </div>
            <ol>
                <li><span>01</span><strong>Verify email</strong><p>Create the account and confirm the registered email before access.</p></li>
                <li><span>02</span><strong>Activate checkout</strong><p>Use hosted checkout so payment data stays outside SecureRepos forms.</p></li>
                <li><span>03</span><strong>Connect GitHub</strong><p>Install the GitHub App and approve only the repositories you want scanned.</p></li>
                <li><span>04</span><strong>Review and fix</strong><p>Track severity, branch, file path, evidence, and current status.</p></li>
            </ol>
        </section>

        <section class="sec-pricing" id="pricing">
            <div class="sec-section-copy">
                <p class="sec-kicker">Pricing</p>
                <h2>Two packages. Clear limits. No enterprise maze.</h2>
                <p>Starter covers practical repository security for small projects. Pro adds deeper automation: daily scans, external alert channels, CI runtime guard, MCP access, safe remediation PRs, and longer retained history.</p>
            </div>
            <div class="product-pricing-grid" data-public-pricing>
                <article class="card card-body plan-card"><p class="muted">Loading current package...</p></article>
            </div>
        </section>

        <section class="sec-final">
            <div>
                <p class="sec-kicker">Ready</p>
                <h2>Start with one approved repository.</h2>
                <p>Open the demo, review the flow, then connect GitHub when you are ready.</p>
            </div>
            <div class="sec-actions">
                <a class="button primary" href="/sign-up">Start security preview</a>
                <a class="button" href="/demo">Open demo</a>
            </div>
        </section>

        <footer class="landing-footer">
            <div class="landing-footer-brand">
                <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
                <p class="muted small">GitHub repository security scanning, CLI access, MCP workflows, and practical remediation for independent developers.</p>
            </div>
            <div class="landing-footer-grid">
                <div>
                    <h3>Product</h3>
                    <a href="/demo">Demo</a>
                    <a href="#coverage">Coverage</a>
                    <a href="#packages">Packages</a>
                    <a href="#agents">Agents</a>
                    <a href="/faqs">FAQ</a>
                </div>
                <div>
                    <h3>Account</h3>
                    <a href="/sign-in">Sign in</a>
                    <a href="/sign-up">Create account</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h3>Legal</h3>
                    <a href="/terms">Terms</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/refund-policy">Refund Policy</a>
                    <a href="/do-not-sell">Do Not Sell/Share</a>
                </div>
            </div>
        </footer>
        <div class="landing-footer-bottom">
            <span>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
        </div>
        <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5l7 7-1.4 1.4-4.6-4.6V20h-2V8.8l-4.6 4.6L5 12l7-7z"></path></svg>
        </button>
        <%- include('../partials/cookie-consent') %>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
