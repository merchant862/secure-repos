<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body data-force-theme="dark">
    <main class="landing-shell">
        <nav class="landing-nav">
            <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
            <div class="landing-nav-links">
                <a href="#platform">Scans</a>
                <a href="#workflow">Workflow</a>
                <a href="#pricing">Pricing</a>
                <a href="#access">Access</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
            </div>
            <div class="toolbar-actions landing-nav-actions"><a class="button" href="/sign-in">Sign in</a><a class="button primary" href="/sign-up">Create account</a></div>
            <button class="landing-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-landing-menu-toggle>
                <span></span><span></span><span></span>
            </button>
            <div class="landing-mobile-menu" data-landing-menu>
                <a href="#platform">Scans</a>
                <a href="#workflow">Workflow</a>
                <a href="#pricing">Pricing</a>
                <a href="#access">Access</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
                <div class="landing-mobile-actions">
                    <a class="button" href="/sign-in">Sign in</a>
                    <a class="button primary" href="/sign-up">Create account</a>
                </div>
            </div>
        </nav>
        <section class="landing-hero">
            <div class="landing-hero-copy">
                <span class="badge brand">Repository security workspace</span>
                <h1>Find risky repository changes before they reach customers.</h1>
                <p class="muted">SecureRepos gives small GitHub teams a practical place to scan repositories, assign findings, and export security progress without buying a heavy enterprise suite.</p>
                <div class="toolbar-actions" style="justify-content:flex-start"><a class="button primary" href="/sign-up">Create workspace</a><a class="button" href="/demo">View product demo</a></div>
                <div class="landing-trust-row">
                    <span>GitHub</span>
                    <span>GitHub App</span>
                    <span>Push Webhooks</span>
                    <span>Reports</span>
                </div>
            </div>
            <div class="landing-visual-column">
                <div class="security-animation" aria-hidden="true">
                    <div class="security-grid"></div>
                    <div class="security-shield"><span></span></div>
                    <div class="security-scan-line"></div>
                    <div class="security-code-stream">
                        <span>token_scan</span>
                        <span>ci_guard</span>
                        <span>secret_match</span>
                    </div>
                </div>
            <div class="demo-frame">
                <div class="demo-top"><span></span><span></span><span></span></div>
                <div class="demo-frame-header">
                    <div><strong>Member Dashboard</strong><p class="muted small">Repos, findings, and workflow in sync</p></div>
                    <span class="badge success">86 score</span>
                </div>
                <div class="landing-demo-focus">
                    <span class="badge danger">Today's Focus</span>
                    <strong>Review 7 critical findings before deploy.</strong>
                    <p class="muted small">Secrets, CI permissions, Dockerfile risk, and package flags stay visible at a glance.</p>
                </div>
                <div class="landing-demo-progress">
                    <div><strong>74%</strong><span>weekly progress</span></div>
                    <div class="progress"><span style="width:74%"></span></div>
                </div>
                <div class="landing-demo-list">
                    <article><span class="badge brand">Secrets</span><p>API token pattern detected in checkout config</p></article>
                    <article><span class="badge warning">CI</span><p>Workflow grants broad write permissions</p></article>
                    <article><span class="badge success">Report</span><p>Weekly posture export ready for review</p></article>
                </div>
            </div>
            </div>
        </section>
        <section class="landing-band landing-band-dark" id="platform">
            <div class="landing-section-heading">
                <span class="badge brand">Platform</span>
                <h2>Clear security operations for teams that need direction, not noise.</h2>
                <p class="muted">Connect once, scan the repositories that matter, and keep the next security action visible without opening a spreadsheet.</p>
            </div>
            <div class="grid grid-3 landing-features">
                <article class="landing-feature-card"><span>01</span><strong>Repository Scans</strong><p class="muted small">Detect secrets, risky config, CI permission issues, Dockerfile gaps, and package concerns.</p></article>
                <article class="landing-feature-card"><span>02</span><strong>Finding Ownership</strong><p class="muted small">Assign, resolve, snooze, ignore, and review findings with clear team accountability.</p></article>
                <article class="landing-feature-card"><span>03</span><strong>Security Reports</strong><p class="muted small">Export posture summaries for customers, partners, and internal security reviews.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-light">
            <div class="landing-section-heading">
                <span class="badge success">Designed to feel useful from day one</span>
                <h2>Everything important stays close to the team’s daily work.</h2>
            </div>
            <div class="landing-experience-grid">
                <article><strong>GitHub App access</strong><p>Teams install the GitHub App after signup so selected repositories stay tied to a real workspace.</p></article>
                <article><strong>Visible progress</strong><p>Scores, open findings, scan activity, and reports show whether security work is actually moving.</p></article>
                <article><strong>Focused workflow</strong><p>The product stays centered on scanning, triage, ownership, notification, and reporting.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-dark" id="workflow">
            <div class="landing-section-heading">
                <span class="badge brand">Daily workflow</span>
                <h2>A simple security routine your team can follow every week.</h2>
            </div>
            <div class="landing-step-grid">
                <article><span>1</span><strong>Install GitHub App</strong><p class="muted small">Choose the GitHub repositories that should be monitored.</p></article>
                <article><span>2</span><strong>Run scans</strong><p class="muted small">Review security checks for secrets, config, CI, Docker, and packages.</p></article>
                <article><span>3</span><strong>Assign owners</strong><p class="muted small">Move findings into ownership instead of letting them sit in a backlog.</p></article>
                <article><span>4</span><strong>Export progress</strong><p class="muted small">Generate reports that show what changed and what still needs attention.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-pricing" id="pricing">
            <div class="landing-section-heading">
                <span class="badge warning">Pricing</span>
                <h2>Simple plans for small teams and focused repository coverage.</h2>
                <p class="muted">Final pricing can stay editable from the admin side, but the public page now shows the intended customer-facing structure.</p>
            </div>
            <div class="grid grid-3">
                <article class="card card-body plan-card">
                    <span class="badge brand">Starter</span>
                    <div class="metric-value">$29<span class="plan-period">/mo</span></div>
                    <p class="muted small">For solo builders and early repositories.</p>
                    <ul class="plan-list"><li>5 repositories</li><li>1 team seat</li><li>Manual scans</li><li>Basic reports</li></ul>
                    <a class="button" href="/sign-up">Choose Starter</a>
                </article>
                <article class="card card-body plan-card plan-featured">
                    <span class="badge success">Recommended</span>
                    <div class="metric-value">$79<span class="plan-period">/mo</span></div>
                    <p class="muted small">For small teams that need workflow and ownership.</p>
                    <ul class="plan-list"><li>50 repositories</li><li>12 team seats</li><li>Scheduled scans</li><li>Audit log and exports</li></ul>
                    <a class="button primary" href="/sign-up">Choose Team</a>
                </article>
                <article class="card card-body plan-card">
                    <span class="badge warning">Growth</span>
                    <div class="metric-value">$149<span class="plan-period">/mo</span></div>
                    <p class="muted small">For agencies and teams watching more repos.</p>
                    <ul class="plan-list"><li>150 repositories</li><li>30 team seats</li><li>Priority scan queue</li><li>Advanced reports</li></ul>
                    <a class="button" href="/sign-up">Choose Growth</a>
                </article>
            </div>
        </section>
        <section class="landing-access" id="access">
            <div>
                <span class="badge warning">Access model</span>
                <h2>Signup first. Payment next. Provider connection after that.</h2>
                <p class="muted">The workspace is created with email and password. After plan activation, users install the GitHub App and begin real scans. The public demo stays separate for product preview.</p>
            </div>
            <div class="landing-access-actions">
                <a class="button primary" href="/sign-up">Create account</a>
                <a class="button" href="/demo">Open demo</a>
            </div>
        </section>
        <footer class="landing-footer">
            <div class="landing-footer-brand">
                <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
                <p class="muted small">Repository monitoring, scanner workflow, team accountability, and security reporting for small engineering teams.</p>
                <div class="payment-marks" aria-label="Accepted payment methods">
                    <span class="payment-mark visa">VISA</span>
                    <span class="payment-mark mastercard"><i></i><b></b></span>
                    <span class="payment-mark amex">AMEX</span>
                    <span class="payment-mark discover">DISCOVER</span>
                    <span class="payment-mark diners">DINERS</span>
                    <span class="payment-mark jcb">JCB</span>
                    <span class="payment-mark unionpay">UP</span>
                    <span class="payment-mark maestro">MAESTRO</span>
                    <span class="payment-mark elo">ELO</span>
                </div>
            </div>
            <div class="landing-footer-grid">
                <div>
                    <h3>Product</h3>
                    <a href="/demo">Demo</a>
                    <a href="#platform">Scans</a>
                    <a href="#workflow">Workflow</a>
                    <a href="#pricing">Pricing</a>
                    <a href="/faqs">FAQ</a>
                </div>
                <div>
                    <h3>Account</h3>
                    <a href="/sign-in">Sign in</a>
                    <a href="/sign-up">Create account</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h3>Legal</h3>
                    <a href="/terms">Terms</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/refund-policy">Refund Policy</a>
                    <a href="/do-not-sell">Do Not Sell/Share</a>
                </div>
            </div>
        </footer>
        <div class="landing-footer-bottom">
            <span>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
            <span>Hosted card checkout will be handled by the selected payment provider.</span>
        </div>
        <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5l7 7-1.4 1.4-4.6-4.6V20h-2V8.8l-4.6 4.6L5 12l7-7z"></path></svg>
        </button>
        <%- include('../partials/cookie-consent') %>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
