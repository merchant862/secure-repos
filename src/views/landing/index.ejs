<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body data-force-theme="dark">
    <main class="landing-shell">
        <nav class="landing-nav">
            <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
            <div class="landing-nav-links">
                <a href="#platform">Scans</a>
                <a href="#languages">Languages</a>
                <a href="#workflow">How it works</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
            </div>
            <div class="toolbar-actions landing-nav-actions"><a class="button" href="/sign-in">Sign in</a><a class="button primary" href="/sign-up">Create account</a></div>
            <button class="landing-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-landing-menu-toggle>
                <span></span><span></span><span></span>
            </button>
            <div class="landing-mobile-menu" data-landing-menu>
                <a href="#platform">Scans</a>
                <a href="#languages">Languages</a>
                <a href="#workflow">How it works</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
                <div class="landing-mobile-actions">
                    <a class="button" href="/sign-in">Sign in</a>
                    <a class="button primary" href="/sign-up">Create account</a>
                </div>
            </div>
        </nav>
        <section class="landing-hero">
            <div class="landing-hero-copy">
                <span class="badge brand">GitHub repository security for solo operators</span>
                <h1>Catch the security issues that usually slip through small teams.</h1>
                <p class="muted">SecureRepos monitors the GitHub repositories you select and flags exposed secrets, risky Actions workflows, dependency CVEs, Docker/config mistakes, and branch-level findings before they become cleanup work.</p>
                <div class="toolbar-actions" style="justify-content:flex-start"><a class="button primary" href="/sign-up">Create account</a><a class="button" href="/demo">View demo workspace</a></div>
                <div class="landing-trust-row" aria-label="SecureRepos product guardrails">
                    <span>Selected repositories only</span>
                    <span>Paddle handles payments</span>
                    <span>Human review stays in the loop</span>
                </div>
                <div class="landing-hero-metrics" aria-label="SecureRepos scan coverage">
                    <span><strong>30+</strong><small>languages and config formats</small></span>
                    <span><strong>50</strong><small>branches per repository scan</small></span>
                    <span><strong>Scan history</strong><small>plan-based retention</small></span>
                </div>
            </div>
            <div class="landing-visual-column">
                <div class="security-animation" aria-hidden="true">
                    <div class="security-grid"></div>
                    <div class="security-shield"><span></span></div>
                    <div class="security-scan-line"></div>
                    <div class="security-code-stream">
                        <span>token_scan</span>
                        <span>ci_guard</span>
                        <span>secret_match</span>
                    </div>
                </div>
                <div class="demo-frame">
                    <div class="demo-top"><span></span><span></span><span></span></div>
                    <div class="demo-frame-header">
                        <div><strong>Security overview</strong><p class="muted small">Repos that need owner attention today</p></div>
                        <span class="badge success">86 score</span>
                    </div>
                    <div class="landing-demo-focus">
                        <span class="badge danger">Needs attention</span>
                        <strong>One exposed token and two unsafe workflow permissions.</strong>
                        <p class="muted small">Each finding includes the branch, file, severity, and practical remediation context.</p>
                    </div>
                    <div class="landing-demo-progress">
                        <div><strong>74%</strong><span>repository health</span></div>
                        <div class="progress"><span style="width:74%"></span></div>
                    </div>
                    <div class="landing-demo-list">
                        <article><span class="badge brand">Secrets</span><p>API token pattern detected in checkout config</p></article>
                        <article><span class="badge warning">CI</span><p>Workflow grants broad write permissions</p></article>
                        <article><span class="badge success">Evidence</span><p>Branch-level scan result ready for review</p></article>
                    </div>
                </div>
            </div>
        </section>
        <section class="landing-scan-flow" aria-label="SecureRepos scan workflow">
            <article>
                <span>01</span>
                <strong>Install the GitHub App</strong>
                <p>Select only the repositories that belong in your SecureRepos workspace.</p>
            </article>
            <article>
                <span>02</span>
                <strong>Scan supported files and branches</strong>
                <p>Secrets, CI/CD, Docker, dependency manifests, and config risk are checked together.</p>
            </article>
            <article>
                <span>03</span>
                <strong>Review owner-friendly findings</strong>
                <p>Severity, branch, file path, evidence, and remediation context stay in one queue.</p>
            </article>
            <article>
                <span>04</span>
                <strong>Track cleanup</strong>
                <p>Keep scan history and finding status available for owner review.</p>
            </article>
        </section>
        <section class="landing-band landing-band-light" id="platform">
            <div class="landing-section-heading">
                <span class="badge brand">What it checks</span>
                <h2>Focused checks for the risks small GitHub projects actually need to track.</h2>
                <p class="muted">SecureRepos is intentionally lightweight. It covers high-signal repository risks without pretending to replace a full security audit or enterprise SAST program.</p>
            </div>
            <div class="grid grid-3 landing-features">
                <article class="landing-feature-card"><span>01</span><strong>Secrets and credentials</strong><p class="muted small">Catch common API keys, private keys, database URLs, and hardcoded credentials before they become incidents.</p></article>
                <article class="landing-feature-card"><span>02</span><strong>CI and configuration</strong><p class="muted small">Review broad workflow permissions, unsafe scripts, risky Docker settings, and repository hygiene issues.</p></article>
                <article class="landing-feature-card"><span>03</span><strong>Dependency CVEs</strong><p class="muted small">Check supported package manifests and lockfiles against known vulnerable package versions.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-dark landing-language-band" id="languages">
            <div class="landing-language-intro">
                <div class="landing-section-heading">
                    <span class="badge success">30+ languages and config formats</span>
                    <h2>Wide repository coverage without turning every scan into a heavy SAST job.</h2>
                    <p class="muted">SecureRepos reads supported text and dependency files through your GitHub App installation and checks for leaked credentials, risky command execution patterns, CI/CD mistakes, Docker risks, known vulnerable package versions, and GitHub-native Dependabot or secret scanning alerts.</p>
                </div>
                <div class="landing-scan-note">
                    <strong>What the scanner focuses on</strong>
                    <span>Secrets</span>
                    <span>Configuration risk</span>
                    <span>CI/CD permissions</span>
                    <span>Dependency alerts</span>
                    <span>Lightweight code-risk patterns</span>
                </div>
            </div>
            <div class="language-carousel" aria-label="Supported languages and file formats">
                <% const languageLogos = [
                    ['JavaScript', 'javascript/javascript-original.svg'],
                    ['TypeScript', 'typescript/typescript-original.svg'],
                    ['PHP', 'php/php-original.svg'],
                    ['Python', 'python/python-original.svg'],
                    ['Ruby', 'ruby/ruby-original.svg'],
                    ['Go', 'go/go-original.svg'],
                    ['Java', 'java/java-original.svg'],
                    ['Kotlin', 'kotlin/kotlin-original.svg'],
                    ['C#', 'csharp/csharp-original.svg'],
                    ['Rust', 'rust/rust-original.svg'],
                    ['C', 'c/c-original.svg'],
                    ['C++', 'cplusplus/cplusplus-original.svg'],
                    ['Swift', 'swift/swift-original.svg'],
                    ['Scala', 'scala/scala-original.svg'],
                    ['Dart', 'dart/dart-original.svg'],
                    ['Lua', 'lua/lua-original.svg'],
                    ['Perl', 'perl/perl-original.svg'],
                    ['Elixir', 'elixir/elixir-original.svg'],
                    ['Erlang', 'erlang/erlang-original.svg'],
                    ['Clojure', 'clojure/clojure-original.svg'],
                    ['Haskell', 'haskell/haskell-original.svg'],
                    ['R', 'r/r-original.svg'],
                    ['Julia', 'julia/julia-original.svg'],
                    ['Groovy', 'groovy/groovy-original.svg'],
                    ['HTML5', 'html5/html5-original.svg'],
                    ['CSS3', 'css3/css3-original.svg'],
                    ['Vue', 'vuejs/vuejs-original.svg'],
                    ['Svelte', 'svelte/svelte-original.svg'],
                    ['Docker', 'docker/docker-original.svg'],
                    ['Terraform', 'terraform/terraform-original.svg']
                ]; %>
                <% for (let row = 0; row < 2; row += 1) { %>
                    <div class="language-carousel-track" aria-hidden="<%= row === 1 ? 'true' : 'false' %>">
                        <% languageLogos.forEach(function (item) { %>
                            <span class="language-logo-card">
                                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/<%= item[1] %>" alt="<%= item[0] %> logo" loading="lazy">
                                <b><%= item[0] %></b>
                            </span>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </section>
        <section class="landing-band landing-band-light">
            <div class="landing-section-heading">
                <span class="badge success">Designed for repeat use</span>
                <h2>Security workflow for developers who still have to ship product.</h2>
            </div>
            <div class="landing-experience-grid">
                <article><strong>Scoped access</strong><p>Install the GitHub App only on the repositories you want monitored. You can revoke access from GitHub at any time.</p></article>
                <article><strong>Readable findings</strong><p>Severity, affected branch, file path, evidence, and remediation guidance are kept together.</p></article>
                <article><strong>Predictable limits</strong><p>Repository limits, scan cadence, and package details are visible before checkout and from Billing.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-dark" id="workflow">
            <div class="landing-section-heading">
                <span class="badge brand">How it works</span>
                <h2>Connect GitHub, scan selected repositories, fix what matters.</h2>
            </div>
            <div class="landing-step-grid">
                <article><span>1</span><strong>Create the workspace</strong><p class="muted small">Pick a package, confirm checkout, and keep billing tied to one owner account.</p></article>
                <article><span>2</span><strong>Select repositories</strong><p class="muted small">Install the GitHub App with selected repository access instead of broad account-wide access.</p></article>
                <article><span>3</span><strong>Run targeted scans</strong><p class="muted small">Each scan keeps GitHub API usage bounded while still checking branches, dependency files, workflows, and configs.</p></article>
                <article><span>4</span><strong>Resolve and verify</strong><p class="muted small">Use the findings queue to resolve issues and rerun scans when needed.</p></article>
            </div>
        </section>
        <section class="landing-band landing-band-pricing landing-band-light" id="pricing">
            <div class="landing-section-heading">
                <span class="badge warning">Pricing</span>
                <h2>Two plans, both built for solo developers.</h2>
                <p class="muted">Choose based on active repository count, scan cadence, finding history, and alert coverage.</p>
            </div>
            <div class="landing-pricing-grid" data-public-pricing>
                <article class="card card-body plan-card"><p class="muted">Loading current plans...</p></article>
            </div>
        </section>
        <section class="landing-access landing-access-dark" id="access">
            <div>
                <span class="badge warning">Access model</span>
                <h2>Review the workflow before granting repository access.</h2>
                <p class="muted">The public demo shows the dashboard, billing controls, and finding workflow without touching a real repository. When you are ready, create an account, activate a plan, and install the GitHub App.</p>
            </div>
            <div class="landing-access-actions">
                <a class="button primary" href="/sign-up">Create account</a>
                <a class="button" href="/demo">Open demo</a>
            </div>
        </section>
        <footer class="landing-footer">
            <div class="landing-footer-brand">
                <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
                <p class="muted small">GitHub repository security scanning, branch-level findings, and practical remediation for independent developers.</p>
            </div>
            <div class="landing-footer-grid">
                <div>
                    <h3>Product</h3>
                    <a href="/demo">Demo</a>
                    <a href="#platform">Scans</a>
                    <a href="#workflow">Workflow</a>
                    <a href="#pricing">Pricing</a>
                    <a href="/faqs">FAQ</a>
                </div>
                <div>
                    <h3>Account</h3>
                    <a href="/sign-in">Sign in</a>
                    <a href="/sign-up">Create account</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h3>Legal</h3>
                    <a href="/terms">Terms</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/refund-policy">Refund Policy</a>
                    <a href="/do-not-sell">Do Not Sell/Share</a>
                </div>
            </div>
        </footer>
        <div class="landing-footer-bottom">
            <span>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
        </div>
        <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5l7 7-1.4 1.4-4.6-4.6V20h-2V8.8l-4.6 4.6L5 12l7-7z"></path></svg>
        </button>
        <%- include('../partials/cookie-consent') %>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
