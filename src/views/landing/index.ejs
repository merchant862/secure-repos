<!doctype html>
<html lang="en">
<head><%- include('../partials/head', { title, appName, seo: typeof seo !== 'undefined' ? seo : undefined }) %></head>
<body data-force-theme="dark">
    <main class="landing-shell product-landing">
        <nav class="landing-nav">
            <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
            <div class="landing-nav-links">
                <a href="#platform">Scans</a>
                <a href="#workflow">How it works</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
            </div>
            <div class="toolbar-actions landing-nav-actions"><a class="button" href="/sign-in">Sign in</a><a class="button primary" href="/sign-up">Create account</a></div>
            <button class="landing-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-landing-menu-toggle>
                <span></span><span></span><span></span>
            </button>
            <div class="landing-mobile-menu" data-landing-menu>
                <a href="#platform">Scans</a>
                <a href="#workflow">How it works</a>
                <a href="#pricing">Pricing</a>
                <a href="/demo">Demo</a>
                <a href="/faqs">FAQ</a>
                <a href="/contact">Contact</a>
                <div class="landing-mobile-actions">
                    <a class="button" href="/sign-in">Sign in</a>
                    <a class="button primary" href="/sign-up">Create account</a>
                </div>
            </div>
        </nav>
        <section class="product-hero rafter-hero">
            <div class="product-hero-copy">
                <span class="product-status-pill">Repository checks ready</span>
                <h1>Simple repository security for people who ship code.</h1>
                <p>Connect GitHub, choose the repositories that matter, and get practical findings for secrets, vulnerable packages, unsafe workflows, Docker, IaC, and package inventory risk.</p>
                <div class="product-actions">
                    <a class="button primary" href="/sign-up">Start security preview</a>
                    <a class="button" href="/demo">View demo</a>
                </div>
            </div>
            <div class="rafter-product-surface" aria-label="SecureRepos scan summary">
                <div class="surface-window">
                    <div class="surface-title">
                        <span>SecureRepos live preview</span>
                        <strong>merchant/checkout-api</strong>
                    </div>
                    <div class="surface-score">
                        <span>3</span>
                        <p>findings need review</p>
                    </div>
                    <div class="surface-checks">
                        <article><b>Secrets</b><span>1 critical</span></article>
                        <article><b>CI/CD</b><span>2 high risk</span></article>
                        <article><b>Dependencies</b><span>8 advisories</span></article>
                    </div>
                    <div class="surface-evidence">
                        <p><b>finding</b><span>payment token pattern in config/prod.env</span></p>
                        <p><b>evidence</b><span>branch: main · source: secret scan · status: open</span></p>
                    </div>
                </div>
                <div class="surface-command">
                    <code>scan queued -> scanners running -> findings parsed</code>
                </div>
            </div>
        </section>

        <section class="product-strip rafter-proof-row" aria-label="SecureRepos operating model">
            <span>Selected repository access</span>
            <span>Queued repository checks</span>
            <span>Findings in one dashboard</span>
        </section>

        <section class="cli-section" id="cli">
            <div class="cli-copy">
                <span class="product-kicker">CLI package</span>
                <h2>Scan approved repositories from your terminal too.</h2>
                <p>Install the SecureRepos npm package, add a short-lived access token from Settings, and run scans from Windows, macOS, or Linux. CLI tokens only work for repositories already approved in your dashboard.</p>
            </div>
            <div class="cli-code-card" aria-label="SecureRepos CLI install commands">
                <div class="cli-code-top">
                    <span></span><span></span><span></span>
                    <strong>terminal</strong>
                </div>
                <pre><code><span class="prompt">$</span> npm install -g securerepos
<span class="prompt">$</span> securerepos auth --token srp_cli_xxxxx
<span class="prompt">$</span> securerepos scan --repo merchant/checkout-api</code></pre>
            </div>
        </section>

        <section class="product-section" id="platform">
            <div class="product-section-heading">
                <span class="product-kicker">Coverage</span>
                <h2>Enough coverage to catch common repository risk, without pretending to replace a full audit.</h2>
                <p>SecureRepos combines repository context, dependency intelligence, configuration checks, and secret detection into practical findings for independent developers.</p>
            </div>
            <div class="scanner-table">
                <article><strong>Secrets</strong><span>Credential exposure</span><p>Detect committed tokens, keys, passwords, database URLs, and credential-like strings.</p></article>
                <article><strong>Dependencies</strong><span>Known vulnerabilities</span><p>Review package manifests and lockfiles for vulnerable package versions.</p></article>
                <article><strong>CI/CD</strong><span>Workflow risk</span><p>Flag broad permissions, risky shell patterns, and unsafe automation defaults.</p></article>
                <article><strong>Containers</strong><span>Image and file risk</span><p>Surface risky Dockerfile patterns, exposed files, and package-level concerns.</p></article>
                <article><strong>Infrastructure</strong><span>IaC configuration</span><p>Check common Terraform, Kubernetes, and deployment configuration mistakes.</p></article>
                <article><strong>Package Inventory</strong><span>Review context</span><p>Keep dependency and package context attached to scan history and findings.</p></article>
            </div>
        </section>

        <section class="product-section comparison-section" id="comparison">
            <div class="product-section-heading">
                <span class="product-kicker">Comparison</span>
                <h2>Choose the tool that matches how much security process you want to run.</h2>
                <p>SecureRepos is intentionally focused: GitHub repository monitoring, readable findings, CLI access, and a simple owner workflow for developers who do not want to operate a full AppSec program.</p>
            </div>
            <div class="comparison-grid">
                <article class="comparison-card featured">
                    <span>SecureRepos</span>
                    <h3>Focused repository security for solo operators</h3>
                    <ul>
                        <li>Selected GitHub repositories only</li>
                        <li>Dashboard plus npm CLI workflow</li>
                        <li>One package, one preview, fewer decisions</li>
                        <li>Built around practical findings and cleanup</li>
                    </ul>
                </article>
                <article class="comparison-card">
                    <span>Snyk-style platforms</span>
                    <h3>Broader AppSec programs and larger teams</h3>
                    <ul>
                        <li>Wide SDLC coverage across code, dependencies, containers, and IaC</li>
                        <li>More governance, policy, integrations, and team process</li>
                        <li>Useful when security ownership is shared across an organization</li>
                        <li>Can be more platform than a solo developer needs</li>
                    </ul>
                </article>
                <article class="comparison-card">
                    <span>Rafter-style tools</span>
                    <h3>Fast scan loops for builders and coding agents</h3>
                    <ul>
                        <li>Strong fit for agent-assisted development workflows</li>
                        <li>Prompt, CLI, dashboard, and API oriented scanning</li>
                        <li>Good when you want security feedback inside the build loop</li>
                        <li>Different focus than account-bound repository monitoring</li>
                    </ul>
                </article>
            </div>
        </section>

        <section class="product-section open-source-comparison">
            <div class="product-section-heading">
                <span class="product-kicker">Open-source scanners</span>
                <h2>Running tools yourself gives control. SecureRepos gives a managed workflow.</h2>
            </div>
            <div class="compare-table">
                <div><strong>Setup</strong><span>Manual installs, updates, config, and output formats</span><span>Connect GitHub, select repos, run scans from the dashboard or CLI</span></div>
                <div><strong>Results</strong><span>Separate terminal output and report files to merge yourself</span><span>Findings grouped by repo, branch, severity, evidence, and status</span></div>
                <div><strong>Operations</strong><span>You handle queues, cleanup, retention, and repeat scans</span><span>Scan queue, history, cleanup workflow, and email alerts are built in</span></div>
                <div><strong>Best fit</strong><span>Security engineers who want full scanner control</span><span>Founders and developers who want useful signal without maintaining tooling</span></div>
            </div>
        </section>

        <section class="product-section product-section-muted" id="workflow">
            <div class="product-section-heading">
                <span class="product-kicker">Workflow</span>
                <h2>From signup to findings without making the user think too much.</h2>
            </div>
            <div class="workflow-list">
                <article><span>1</span><div><strong>Verify email and activate preview</strong><p>Account activation starts only after email verification and hosted checkout setup.</p></div></article>
                <article><span>2</span><div><strong>Install GitHub App</strong><p>Select the repositories you want monitored. The first GitHub account is bound to the workspace.</p></div></article>
                <article><span>3</span><div><strong>Run queued scans</strong><p>Scan requests are queued so the server does not run every scanner at once.</p></div></article>
                <article><span>4</span><div><strong>Fix and track</strong><p>Findings keep severity, source, branch, path, evidence, and status in the dashboard.</p></div></article>
            </div>
        </section>

        <section class="product-section product-pricing-section" id="pricing">
            <div class="product-section-heading">
                <span class="product-kicker">Pricing</span>
                <h2>One package. One preview. No plan maze.</h2>
                <p>The Security Preview gives one repository and one limited scan with a payment method required. Full scanner output, scheduled scans, alerts, and retained findings unlock with the paid package.</p>
            </div>
            <div class="product-pricing-grid" data-public-pricing>
                <article class="card card-body plan-card"><p class="muted">Loading current package...</p></article>
            </div>
        </section>

        <section class="product-cta">
            <div>
                <span class="product-kicker">Before connecting GitHub</span>
                <h2>Open the demo before granting repository access.</h2>
                <p>The demo shows the dashboard, billing controls, scan queue, and finding flow without asking for repository access.</p>
            </div>
            <div class="product-actions">
                <a class="button primary" href="/sign-up">Start security preview</a>
                <a class="button" href="/demo">Open demo</a>
            </div>
        </section>
        <footer class="landing-footer">
            <div class="landing-footer-brand">
                <a class="brand" href="/" style="padding:0"><%- include('../partials/brand-logo') %></a>
                <p class="muted small">GitHub repository security scanning, branch-level findings, and practical remediation for independent developers.</p>
            </div>
            <div class="landing-footer-grid">
                <div>
                    <h3>Product</h3>
                    <a href="/demo">Demo</a>
                    <a href="#platform">Scans</a>
                    <a href="#workflow">Workflow</a>
                    <a href="#pricing">Pricing</a>
                    <a href="/faqs">FAQ</a>
                </div>
                <div>
                    <h3>Account</h3>
                    <a href="/sign-in">Sign in</a>
                    <a href="/sign-up">Create account</a>
                    <a href="/contact">Contact</a>
                </div>
                <div>
                    <h3>Legal</h3>
                    <a href="/terms">Terms</a>
                    <a href="/privacy">Privacy</a>
                    <a href="/refund-policy">Refund Policy</a>
                    <a href="/do-not-sell">Do Not Sell/Share</a>
                </div>
            </div>
        </footer>
        <div class="landing-footer-bottom">
            <span>© <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</span>
        </div>
        <button class="back-to-top" type="button" aria-label="Back to top" data-back-to-top>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5l7 7-1.4 1.4-4.6-4.6V20h-2V8.8l-4.6 4.6L5 12l7-7z"></path></svg>
        </button>
        <%- include('../partials/cookie-consent') %>
    </main>
    <script src="/public/js/app.js"></script>
</body>
</html>
