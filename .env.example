# Web server port.
PORT=3000

# Runtime environment: development, test, or production.
NODE_ENV=development

# Public product name used in UI, email, and logs.
APP_NAME=SecureRepos

# Canonical public URL. Used for redirects, sitemap, OAuth callbacks, and emails.
APP_URL=https://securerepos.com

# Legacy fallback URL used by older middleware paths.
SITE_URL=https://securerepos.com

# Browser session cookie name.
AUTH_COOKIE_NAME=securerepos_session

# Express trust proxy setting. Use "loopback" locally and true behind a trusted reverse proxy.
TRUST_PROXY=loopback

# Public support sender/contact address.
SUPPORT_EMAIL=support@securerepos.com

# Database connection for app runtime and sequelize-cli migrations.
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure_repos
DB_USER=secure_repos
DB_PASS=secure_repos_password
DB_ROOT_PASS=secure_repos_root_password

# GitHub App credentials.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=

# 32-byte base64 encryption key for stored provider tokens.
TOKEN_ENCRYPTION_KEY=

# Optional internal admin/API maintenance token.
ADMIN_API_TOKEN=

# Scan worker controls.
SCAN_WORKER_POLL_MS=5000
SCAN_WORKER_CONCURRENCY=1
SCAN_SCHEDULER_INTERVAL_MS=300000
SCAN_MAX_BRANCHES=50
SCAN_MAX_FILES=2000
SCAN_MAX_FILES_PER_BRANCH=250
SCAN_MAX_DURATION_MS=600000
SCAN_MAX_DEPENDENCIES=5000

# GitHub and dependency intelligence timeouts.
GITHUB_REQUEST_TIMEOUT_MS=20000
OSV_API_URL=https://api.osv.dev
OSV_REQUEST_TIMEOUT_MS=20000

# Scanner container controls. Keep disabled locally unless Docker scanner image is built.
DOCKER_SCANNER_ENABLED=false
DOCKER_SCANNER_IMAGE=securerepos/scanner:local
DOCKER_SCANNER_TIMEOUT_MS=900000
DOCKER_SCANNER_TMP_DIR=/tmp/securerepos-scans
DOCKER_SCANNER_MEMORY=1536m
DOCKER_SCANNER_CPUS=1.5

# CI runtime guard ingestion.
CICD_RUNTIME_INGEST_TOKEN=
CICD_RUNTIME_MAX_EVENTS_PER_REQUEST=100
CICD_RUNTIME_FINDINGS_ENABLED=true
CICD_RUNTIME_RETENTION_DAYS=90

# Public CI guard package defaults for customer workflows.
SECUREREPOS_API_URL=https://securerepos.com
SECUREREPOS_RUNTIME_TOKEN=
SECUREREPOS_GUARD_MODE=monitor
SECUREREPOS_FAIL_SEVERITY=high

# Notification and email workers.
NOTIFICATION_WORKER_POLL_MS=10000
NOTIFICATION_DELIVERY_MODE=resend
EMAIL_WORKER_TYPE=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paddle checkout and webhook credentials.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_SOLO_STARTER_PRICE_ID=
PADDLE_SOLO_PRO_PRICE_ID=
