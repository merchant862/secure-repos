{
  "name": "@securerepos/mcp",
  "version": "0.1.0",
  "description": "MCP server for SecureRepos repository security workflows",
  "license": "ISC",
  "type": "module",
  "homepage": "https://github.com/merchant862/secure-repos/tree/agents-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merchant862/secure-repos.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/merchant862/secure-repos/issues"
  },
  "bin": {
    "securerepos-mcp": "dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "security",
    "github",
    "scanner",
    "secrets",
    "dependencies",
    "cve",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ]
}
