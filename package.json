{
  "name": "micro-saas",
  "version": "1.0.0",
  "main": "dist/src/main/start-web.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check --ignore-unknown README.md CHANGELOG.md CONTRIBUTING.md docs/**/*.md .env.example docker-compose.yml Dockerfile .github/**/*.yml",
    "start": "node dist/src/main/start-web.js",
    "start:worker": "node dist/src/main/start-worker.js",
    "start:notifications": "node dist/src/main/start-notification-worker.js",
    "start:scheduler": "node dist/src/main/start-scheduler.js",
    "start:email:login-otp": "node dist/src/main/start-login-otp-email-worker.js",
    "start:email:welcome": "node dist/src/main/start-welcome-email-worker.js",
    "start:email:security-alert": "node dist/src/main/start-security-alert-email-worker.js",
    "start:email:scan-summary": "node dist/src/main/start-scan-summary-email-worker.js",
    "start:email:scan-failed": "node dist/src/main/start-scan-failed-email-worker.js",
    "start:email:finding-status": "node dist/src/main/start-finding-status-email-worker.js",
    "start:email:provider-status": "node dist/src/main/start-provider-status-email-worker.js",
    "start:email:repo-access-failed": "node dist/src/main/start-repository-access-failed-email-worker.js",
    "start:email:critical-reminder": "node dist/src/main/start-critical-finding-reminder-email-worker.js",
    "start:email:password-reset": "node dist/src/main/start-password-reset-email-worker.js",
    "start:email:plan-activated": "node dist/src/main/start-plan-activated-email-worker.js",
    "start:email:payment-failed": "node dist/src/main/start-payment-failed-email-worker.js",
    "start:email:subscription-cancelled": "node dist/src/main/start-subscription-cancelled-email-worker.js",
    "start:email:contact": "node dist/src/main/start-contact-email-worker.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:restart": "pm2 restart ecosystem.config.js --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:save": "pm2 save",
    "db:migrate": "sequelize-cli db:migrate",
    "dev:build": "tsc -w",
    "ci:runtime-guard": "node tools/ci-runtime-guard/guard.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "mysql2": "^3.19.0",
    "sequelize": "^6.37.7",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.9"
  }
}
